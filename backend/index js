app.get('/api/me/status', async (req, res) => {
  try {
    if (!req.session || !req.session.tokens) return res.status(200).json({ connected: false });
    const client = createOAuth2Client(req);
    let userInfo = req.session.user || null;
    if (!userInfo) {
      try { userInfo = await fetchUserInfo(client); req.session.user = userInfo; }
      catch (e) { console.error('Error fetching user info in /api/me/status:', e); }
    }
    const email = userInfo && (userInfo.email || userInfo.primaryEmail);
    res.status(200).json({
      connected:  true,
      userEmail:  email || null,
      given_name: userInfo && userInfo.given_name || null,  // [v4.0] 복구
      user:       userInfo || null
    });
  } catch (err) {
    console.error('Error in /api/me/status:', err);
    res.status(500).json({ connected: false, error: 'STATUS_ERROR' });
  }
});

