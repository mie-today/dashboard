// ============================================================================
// buildHealthRow_ — 탭별 시트 행 생성
// [v4.0] Body 27col, activity add_to_calendar, sleep add_to_calendar,
//        mood energy_level_1to5 + add_to_calendar, baseline dob (17col),
//        water / medication / womens / womens_bp / womens_mood / pregnancy 신규
// ============================================================================
function buildHealthRow_(tab, data) {
  const d = data;
  const stamp = d.stamp_date || new Date().toISOString().slice(0, 19).replace('T', ' ');
  const date  = d.stamp_date || new Date().toISOString().slice(0, 10);

  if (tab === 'food') {
    return [ stamp, d.meal_time || 'AM', d.food_name || '', d.calories_kcal || 0,
      d.protein_g || 0, d.protein_oz || 0, d.carbs_g || 0, d.carbs_oz || 0,
      d.fat_g || 0, d.fat_oz || 0, d.fiber_g || 0, d.fiber_oz || 0,
      d.source || 'Manual', d.notes || '', d.unit_pref || 'metric' ];
  }

  if (tab === 'activity') {
    // [v4.1] 컬럼 순서 수정 — 실제 Activity 시트 헤더 순서(A:stamp_date B:category C:type
    // D:duration_min E:sets F:reps G:weight_per_set_kg H:distance_km I:steps
    // J:calories_burned_kcal K:met_value L:add_to_calendar M:unit_pref N:notes)에 맞춤.
    // 기존엔 sets/reps/weight를 duration_min보다 먼저, distance_mi라는 존재하지 않는
    // 컬럼까지 포함한 16컬럼으로 썼음 — parseHealthRows_와 동일한 원인의 버그.
    return [ stamp, d.category || '', d.type || '',
      d.duration_min || '', d.sets || '', d.reps || '',
      d.weight_per_set_kg || d.weight_kg || '',
      d.distance_km || '', d.steps || '',
      d.calories_burned_kcal || '', d.met_value || '',
      d.add_to_calendar || '', d.unit_pref || 'metric', d.notes || '' ];
  }

  if (tab === 'health') {
    // [v4.0] Body 탭 — 27컬럼 (col 24-26: custom_item_*)
    return [ date,
      d.weight_kg || '', d.weight_lb || '', d.bmi || '',
      d.lean_mass_kg_boer || '', d.lean_mass_lb || '',
      d.body_fat_kg || '', d.body_fat_pct || '',
      d.muscle_mass_kg || '', d.muscle_mass_lb || '',
      d.manual_body_fat_pct || '', d.manual_muscle_mass_kg || '',
      d.blood_pressure_sys || '', d.blood_pressure_dia || '',
      d.heart_rate_bpm || '', d.spo2_pct || '',
      d.glucose_mgdl || '', d.glucose_mmol || '',
      d.temperature_c || '', d.temperature_f || '',
      d.cholesterol_mgdl || '', d.cholesterol_mmol || '',
      d.notes || '', d.unit_pref || 'metric',
      d.custom_item_name || '', d.custom_item_value || '', d.custom_item_unit || '' ];
  }

  if (tab === 'sleep') {
    // [v4.0] add_to_calendar 추가 (col 8)
    return [ date, d.bedtime || '', d.wake_time || '',
      d.duration_min || '', d.duration_hr || '', d.quality_1to5 || '',
      d.notes || '', d.unit_pref || 'metric', d.add_to_calendar || '' ];
  }

  if (tab === 'mood') {
    // [v4.0] energy_level_1to5 (v3.8: energy_level), add_to_calendar 추가 (col 5)
    return [ date, d.mood || '', d.energy_level_1to5 || d.energy_level || '',
      d.notes || '', d.unit_pref || 'metric', d.add_to_calendar || '' ];
  }

  if (tab === 'custom') {
    return [ date, d.item_name || '', d.value || '', d.unit || '', d.notes || '' ];
  }

  if (tab === 'baseline') {
    // [v4.1] 컬럼 순서 수정 — 실제 시트 헤더 순서(A:recorded_date B:dob C:sex D:age E:height_cm...)에
    // 맞춰 dob을 두 번째 자리로 이동. 기존엔 마지막(Q열)에 썼으나 실제 헤더는 B열이라
    // 저장할 때마다 전체 컬럼이 한 칸씩 밀려 기록되고 있었음.
    return [ d.recorded_date || date,
      d.dob || '',
      d.sex || '', d.age || '',
      d.height_cm || '', d.height_ft || '', d.height_in || '',
      d.weight_kg || '', d.weight_lb || '',
      d.blood_type || '', d.allergies || '', d.emergency_contact || '',
      d.activity_level || 1.55, d.activity_label || '',
      d.bmr_kcal || '', d.tdee_kcal || '',
      d.unit_pref || 'metric' ];
  }

  if (tab === 'goal') {
    return [ d.recorded_date || date, d.goal_type || 'maintain',
      d.target_weight_kg || '', d.target_weight_lb || '',
      d.duration_months || '',
      d.daily_calorie_intake_kcal || '', d.daily_exercise_cal_kcal || '',
      d.weekly_pace_kg || '', d.weekly_pace_lb || '',
      d.water_goal_ml || '', d.water_goal_oz || '',
      d.sleep_goal_min || '', d.sleep_goal_hr || '', d.notes || '' ];
  }

  if (tab === 'water') {
    // [v4.0] T-Water — 8컬럼
    return [ stamp, d.amount_ml || '', d.amount_floz || '',
      d.drink_type || 'water', d.time_of_day || '',
      d.goal_ml || '', d.cumulative_ml || '', d.notes || '' ];
  }

  if (tab === 'medication') {
    // [v4.0] T-Medication — 케이스B(복약체크): 기존 행 update
    // 9컬럼: date | med_name | dose | unit | frequency | time_of_day | taken | taken_at | notes
    return [ date, d.med_name || '', d.dose || '', d.unit || '',
      d.frequency || '', d.time_of_day || '',
      d.taken || 'N', d.taken_at || stamp, d.notes || '' ];
  }

  if (tab === 'womens') {
    // [v4.3] Women 탭 — 33컬럼 전체를 프론트(panel-logs-womens_3_.html)가 보내는
    // 중첩 객체에서 평탄화해서 채움. 프론트는 팝업을 저장할 때마다 그날의 전체
    // state.dayData를 통째로 보내므로, 여기서 꺼내 쓰기만 하면 됨(추가 API 호출 없음).
    const symArr = Array.isArray(d.symptoms) ? d.symptoms : [];
    const medArr = Array.isArray(d.medications) ? d.medications : [];
    const cm  = d.cervical_mucus  || {};
    const ovt = d.ovulation_test  || {};
    const pgt = d.pregnancy_test  || {};
    const sex = d.sex             || {};
    const ms  = d.morning_sickness || {};
    const cv  = d.clinic_visit    || {};
    const bp  = d.blood_pressure  || {};
    const wm  = d.womens_mood     || {};

    return [ date,                                          // A stamp_date
      d.mode || '',                                          // B mode
      d.period_start || '',                                  // C period_start
      d.period_end || '',                                    // D period_end
      d.ovulation || '',                                      // E ovulation
      ovt.result || '', ovt.time || '',                       // F ov_test_result, G ov_test_time
      pgt.result || '', pgt.time || '',                       // H preg_test_result, I preg_test_time
      cm.feeling || '', cm.color || '', cm.type || '',        // J~L cervical_mucus_feeling/color/type
      symArr.map(s => s.name).join(', '),                     // M symptoms
      symArr.map(s => `${s.name}:${s.severity}`).join(', '),  // N symptom_severity ("이름:점수" 형식)
      medArr.map(m => `${m.name}(${m.taken ? '복용' : '미복용'})`).join(', '), // O medications
      sex.count ?? '',                                         // P sex_count
      (sex.condom === true || sex.condom === false) ? sex.condom : '', // Q condom
      sex.orgasm_count ?? '',                                  // R orgasm_count
      sex.masturbation_count ?? '',                            // S masturbation_count
      sex.time || '',                                          // T sex_time
      ms.count ?? '', ms.severity || '', ms.note || '',        // U~W morning_sickness_count/severity/note
      cv.type || '', cv.note || '', cv.next_appointment || '', // X~Z clinic_visit_type/note, clinic_next_appointment
      bp.systolic ?? '', bp.diastolic ?? '',                   // AA bp_sys, AB bp_dia
      wm.mood || '', wm.energy_level ?? '',                    // AC mood, AD energy_level
      d.add_to_calendar || '',                                 // AE add_to_calendar
      d.note || '',                                            // AF note (프론트 필드명이 note(단수)라 수정함)
      d.unit_pref || 'metric',                                  // AG unit_pref
      d.calendar_event_id || '' ];                              // AH calendar_event_id [v4.6]
  }

  if (tab === 'womens_bp') {
    // [v4.2] Women_BP 탭 — 실제 시트 헤더(stamp_date, bp_sys, bp_dia, notes, source) 5컬럼.
    // 프론트(panel-logs-womens_3_.html)가 이미 이 필드명 그대로 보내고 있음(bp_sys/bp_dia/notes/source).
    return [ date, d.bp_sys || '', d.bp_dia || '', d.notes || '', d.source || 'womens' ];
  }

  if (tab === 'womens_mood') {
    // [v4.2] Women_Mood 탭 — 실제 시트 헤더(stamp_date, mood, energy_level_1to5, notes, source) 5컬럼.
    // 프론트가 이미 이 필드명 그대로 보내고 있음(mood/energy_level/notes/source).
    return [ date, d.mood || '', d.energy_level || '', d.notes || '', d.source || 'womens' ];
  }

  if (tab === 'fetal_movement' || tab === 'baby_kick') {
    // [v4.0] Pregnancy 탭 — entry_type으로 구분 — 8컬럼
    return [ date, d.entry_type || tab, d.kick_count || '',
      d.session_min || '', d.time_of_day || '',
      d.intensity || '', d.pregnancy_week || '', d.notes || '' ];
  }

  return [];
}

// ============================================================================
// buildHealthEventTitle_ — add_to_calendar='Y'일 때 만들 캘린더 이벤트 제목
// 탭마다 필드가 달라서 탭별로 대표값을 뽑아 제목을 구성한다.
// ============================================================================
function buildHealthEventTitle_(tab, d) {
  switch (tab) {
    case 'food':           return `🍽️ ${d.food_name || 'Food'}${d.calories_kcal ? ` (${d.calories_kcal}kcal)` : ''}`;
    case 'activity':       return `🏃 ${d.type || d.category || 'Activity'}${d.duration_min ? ` ${d.duration_min}min` : ''}`;
    case 'health':         return `❤️ Body log${d.weight_kg ? ` - ${d.weight_kg}kg` : (d.weight_lb ? ` - ${d.weight_lb}lb` : '')}`;
    case 'sleep':          return `😴 Sleep${d.duration_hr ? ` ${d.duration_hr}hr` : ''}`;
    case 'mood':           return `🙂 Mood${d.mood ? `: ${d.mood}` : ''}`;
    case 'custom':         return `📝 ${d.item_name || 'Custom'}${d.value ? ` - ${d.value}${d.unit || ''}` : ''}`;
    case 'water':          return `💧 Water${(d.amount_ml || d.amount_floz) ? ` ${d.amount_ml || d.amount_floz}${d.amount_ml ? 'ml' : 'fl oz'}` : ''}`;
    case 'medication':     return `💊 ${d.med_name || 'Medication'}`;
    case 'womens':         return `Women's health log`;
    case 'womens_bp':      return `Women's BP${(d.bp_sys || d.bp_dia) ? `: ${d.bp_sys || ''}/${d.bp_dia || ''}` : ''}`;
    case 'womens_mood':    return `Women's mood${d.mood ? `: ${d.mood}` : ''}`;
    case 'fetal_movement': return `Fetal movement${d.kick_count ? ` - ${d.kick_count} kicks` : ''}`;
    case 'baby_kick':      return `Baby kick${d.kick_count ? ` - ${d.kick_count}` : ''}`;
    default:               return `Health log: ${tab}`;
  }
}

// ── fetch helper with AbortController timeout ────────────────────────────────
async function fetchWithTimeout_(url, options, timeoutMs) {
  const fetch = (await import('node-fetch')).default;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    return await fetch(url, { ...options, signal: controller.signal });
  } finally {
    clearTimeout(timer);
  }
}

