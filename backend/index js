    const resourceState = req.get('X-Goog-Resource-State');
    console.log(`📅 Calendar push — state: ${resourceState}, token: ${channelToken}`);
    if (!channelToken || resourceState === 'sync') return;
    const userEmail = channelToken.trim().toLowerCase();

    // [Finance] 기존 로직 그대로 — 한 글자도 안 바꿈
    const triggerFinance = async () => {
      if (!CALENDAR_SCRIPT_WEBHOOK) {
