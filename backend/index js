// ============================================================================
// FINANCE NEEDS_REVIEW API
// Sync Log 탭(A:Timestamp, B:Source, C:Raw Event Title, D:Parsed Type, E:Parsed Category,
// F:Parsed Amount, G:Destination Sheet, H:Status, I:Calendar Event ID)에서
// status === 'NEEDS_REVIEW'인 행만 조회하고, 사용자가 승인(Finance 탭에 반영)하거나
// 무시(상태만 변경)할 수 있게 한다.
//
// [식별 방식] I열(Calendar Event ID)은 2026-07-30 이후 새로 기록되는 행부터 채워진다.
// 그 이전에 쌓인 과거 행은 I열이 비어 있으므로, 그런 행은 시트상의 실제 행 번호(rowNumber)로
// 식별한다. 프론트는 GET 응답의 각 항목에 담긴 rowNumber를 그대로 되돌려주기만 하면 되고,
// eventId 유무를 신경 쓸 필요 없다 — resolve/dismiss 라우트가 내부적으로 rowNumber 기준으로
// 처리한다(가장 안전 — 사이에 시트가 수동 편집되면 번호가 밀릴 수 있다는 점은 알려진 한계).
// ============================================================================

function parseSyncLogNeedsReview_(rows) {
  const result = [];
  for (let r = 2; r < rows.length; r++) { // 0,1행은 제목/헤더
    const row = rows[r];
    if (!row || !row[0]) continue;
    const status = (row[7] || '').toString().trim();
    if (status !== 'NEEDS_REVIEW') continue;
    result.push({
      rowNumber:  r + 1, // 시트상 실제 행 번호(1-indexed) — resolve/dismiss에 그대로 되돌려줌
      timestamp:  (row[0] || '').toString().trim(),
      source:     (row[1] || '').toString().trim(),
      rawTitle:   (row[2] || '').toString().trim(),
      parsedType: (row[3] || '').toString().trim(),
      category:   (row[4] || '').toString().trim(),
      amount:     parseFloat((row[5] || '0').toString().replace(/[$,\s]/g, '')) || 0,
      eventId:    (row[8] || '').toString().trim(), // I열 — 과거 행은 빈 문자열
    });
  }
  return result;
}

