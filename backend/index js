async function registerCalendarWatchForUser(email, authClient) {
  const calendar  = google.calendar({ version: 'v3', auth: authClient });

  // [버그 수정] 새 채널을 만들기 전에 예전 채널을 먼저 정지시킨다.
  // 이 함수는 6시간마다 자동 갱신(renewExpiringWatches), /api/calendar/watch,
  // /api/calendar/watch/renew-all 이렇게 세 경로에서 호출되는데, 지금까지는
  // 매번 새 채널만 추가로 등록하고 예전 채널은 절대 stop()하지 않았다.
  // Google Calendar API는 같은 캘린더에 watch 채널이 여러 개 동시에 존재하는 걸
  // 막지 않고, 각 채널이 독립적으로 알림을 보낸다 — 이게 Cal2Health/Cal2Finance
  // 웹훅이 캘린더 변경 한 번에 5번씩 중복 호출되던 근본 원인이었다(2026-07-25 확인).
  // ※ 이미 쌓여있는 예전 채널들은 Firestore에 channelId/resourceId가 남아있지
  // 않아(매번 덮어썼음) 지금 이 코드로는 소급 정지가 안 된다 — 등록 시 준 TTL(7일)이
  // 지나면 자연히 만료된다. 이 수정은 "앞으로" 채널이 더 쌓이는 것만 막는다.
  try {
    const existing = await db.collection('calendar_watch').doc(email).get();
    if (existing.exists) {
      const old = existing.data() || {};
      if (old.channelId && old.resourceId) {
        try {
          await calendar.channels.stop({ requestBody: { id: old.channelId, resourceId: old.resourceId } });
          console.log(`🛑 Stopped previous calendar watch channel for ${email}: ${old.channelId}`);
        } catch (stopErr) {
          // 이미 만료됐거나 Google 쪽에서 모르는 채널일 수 있음 — 새 채널 등록은 계속 진행
          console.warn(`⚠️ Could not stop previous channel for ${email} (may already be expired/invalid): ${stopErr.message}`);
        }
      }
    }
  } catch (e) {
    console.warn(`⚠️ Error checking existing watch for ${email} before renewal: ${e.message}`);
  }

  const channelId = `mie-cal-${email.replace(/[@.]/g, '-')}-${Date.now()}`;
  const watchRes  = await calendar.events.watch({
    calendarId: 'primary',
    requestBody: {
      id:      channelId,
      type:    'web_hook',
      address: 'https://mie-backend-514922143683.us-central1.run.app/api/pubsub/calendar-push',
      token:   email,
      params:  { ttl: '604800' }
    }
  });
  const expiration  = watchRes.data.expiration;
  const resourceId  = watchRes.data.resourceId;
  const expiresDate = expiration ? new Date(parseInt(expiration)).toISOString() : 'unknown';
  await db.collection('calendar_watch').doc(email).set({
    email, channelId, resourceId,
    expiration: expiration || null,
    expiresAt:  expiresDate,
    registeredAt: admin.firestore.FieldValue.serverTimestamp()
  }, { merge: true });
  console.log(`✅ Calendar watch registered for ${email} — expires ${expiresDate}`);
  return { channelId, resourceId, expiresAt: expiresDate };
}

async function renewExpiringWatches() {
  console.log('🔄 [Watch Renewal] Starting scheduled renewal check...');
  try {
    const now   = new Date();
    const in24h = new Date(now.getTime() + 24 * 60 * 60 * 1000);
    const snap  = await db.collection('calendar_watch')
      .where('expiresAt', '<=', in24h.toISOString()).get();
    if (snap.empty) { console.log('✅ [Watch Renewal] No watches expiring within 24h.'); return; }
    console.log(`🔄 [Watch Renewal] ${snap.docs.length} watch(es) expiring within 24h.`);
    for (const doc of snap.docs) {
      const email = doc.id;
      try {
        const refreshToken = await getRefreshTokenForEmail(email);
        if (!refreshToken) { console.warn(`⚠️  [Watch Renewal] No token for ${email}`); continue; }
        const authClient = createOAuth2Client(null);
        authClient.setCredentials({ refresh_token: refreshToken });
        await registerCalendarWatchForUser(email, authClient);
        console.log(`✅ [Watch Renewal] Renewed for ${email}`);
      } catch (e) { console.error(`❌ [Watch Renewal] Failed for ${email}:`, e.message); }
    }
  } catch (e) { console.error('❌ [Watch Renewal] Error:', e.message); }
}

function scheduleWatchRenewal() {
  const INTERVAL_MS = 6 * 60 * 60 * 1000;
  setTimeout(() => {
    renewExpiringWatches();
    setInterval(renewExpiringWatches, INTERVAL_MS);
  }, 60 * 1000);
  console.log('⏰ [Watch Renewal] Scheduler initialized — runs every 6 hours');
}

