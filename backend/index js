      await sheets.spreadsheets.values.clear({ spreadsheetId: healthSheetId, range: `Records!A${sheetRow}:E${sheetRow}` });
    }
    console.log(`✅ Record deleted: ${id} (row ${sheetRow}) for ${userEmail}`);
    res.status(200).json({ ok: true, record_id: id, sheet_row: sheetRow });
  } catch (err) {
    console.error('Error in DELETE /api/me/health/records/:id:', err);
    res.status(500).json({ error: 'RECORD_DELETE_FAILED', message: err.message });
  }
});

// ============================================================================
// POST /api/health/food/search
// USDA FoodData Central (1순위) + Open Food Facts (barcode / fallback)
// ============================================================================
app.post('/api/health/food/search', async (req, res) => {
  try {
    const query   = (req.body && req.body.query)   ? String(req.body.query).trim()   : '';
    const barcode = (req.body && req.body.barcode) ? String(req.body.barcode).trim() : '';
    if (!query && !barcode) return res.status(400).json({ error: 'MISSING_QUERY_OR_BARCODE' });

    const USDA_API_KEY = process.env.USDA_FOOD_API_KEY || 'DEMO_KEY';

    function extractUsdaNutrients_(foodNutrients) {
      const map = {};
      for (const n of (foodNutrients || [])) {
        if (n.nutrientId) map[n.nutrientId] = n.value || 0;
      }
      return map;
    }

    const USDA_PRIORITY = { 'Foundation': 0, 'SR Legacy': 1, 'Survey (FNDDS)': 2, 'Branded': 3 };

    // 1. 바코드 → Open Food Facts
    if (barcode) {
      try {
        const r = await fetchWithTimeout_(
          `https://world.openfoodfacts.org/api/v2/product/${barcode}.json`,
          { headers: { 'User-Agent': 'MIE-Health/1.0 (kairoks.com)' } },
          8000
        );
        if (r.ok) {
          const d = await r.json();
          if (d.status === 1 && d.product) {
            const p = d.product, n = p.nutriments || {};
            console.log(`✅ Food search (barcode ${barcode}) → Open Food Facts`);
            return res.status(200).json({
              foods: [{
                food_name:            p.product_name_en || p.product_name || '',
                brand_name:           p.brands || '',
                calories_kcal:        +(n['energy-kcal_serving'] || n['energy-kcal_100g'] || 0),
                protein_g:            +(n['proteins_serving']    || n['proteins_100g']    || 0),
                carbs_g:              +(n['carbohydrates_serving']|| n['carbohydrates_100g']|| 0),
                fat_g:                +(n['fat_serving']         || n['fat_100g']         || 0),
                fiber_g:              +(n['fiber_serving']       || n['fiber_100g']       || 0),
                serving_qty:          1,
                serving_unit:         p.serving_size || '1 serving',
                serving_weight_grams: parseFloat(p.serving_quantity) || null,
                barcode,
                source: 'Open Food Facts',
              }],
              query: barcode, source: 'Open Food Facts',
            });
          }
        }
      } catch (e) { console.warn('Barcode lookup failed:', e.message); }
      return res.status(200).json({ foods: [], query: barcode, source: null, message: 'Barcode not found.' });
    }

    // 2. 키워드 → USDA FoodData Central
    try {
      const usdaUrl =
        `https://api.nal.usda.gov/fdc/v1/foods/search` +
        `?api_key=${USDA_API_KEY}` +
        `&query=${encodeURIComponent(query)}` +
        `&pageSize=20` +
        `&dataType=Foundation,SR%20Legacy,Survey%20(FNDDS),Branded`;

      const r = await fetchWithTimeout_(usdaUrl, {}, 10000);
      if (r.ok) {
        const data  = await r.json();
        const foods = (data.foods || [])
          .map(food => {
            const nutrients    = extractUsdaNutrients_(food.foodNutrients);
            const servingSize  = food.servingSize || 100;
            const servingUnit  = food.servingSizeUnit || 'g';
            const scale        = servingSize / 100;
            const protein_g    = +((nutrients[1003] || 0) * scale).toFixed(1);
            const carbs_g      = +((nutrients[1005] || 0) * scale).toFixed(1);
            const fat_g        = +((nutrients[1004] || 0) * scale).toFixed(1);
            const fiber_g      = +((nutrients[1079] || 0) * scale).toFixed(1);
            const usdaCal      = +((nutrients[1008] || 0) * scale).toFixed(1);
            const calories_kcal = usdaCal > 0
              ? usdaCal
              : +(protein_g * 4 + carbs_g * 4 + fat_g * 9).toFixed(1);
            return {
              food_name:            food.description || '',
              brand_name:           food.brandOwner || food.brandName || '',
              calories_kcal, protein_g, carbs_g, fat_g, fiber_g,
              serving_qty:          1,
              serving_unit:         `${servingSize}${servingUnit}`,
              serving_weight_grams: servingUnit === 'g' ? servingSize : null,
              fdc_id:               food.fdcId || null,
              data_type:            food.dataType || '',
              source:               'USDA FoodData Central',
            };
          })
          .filter(f => f.food_name && (f.calories_kcal > 0 || f.protein_g > 0))
          .sort((a, b) => (USDA_PRIORITY[a.data_type] ?? 9) - (USDA_PRIORITY[b.data_type] ?? 9))
          .slice(0, 8);

        if (foods.length > 0) {
          console.log(`✅ Food search "${query}" → USDA (${foods.length} results, top: ${foods[0].data_type})`);
          return res.status(200).json({ foods, query, source: 'USDA FoodData Central' });
        }
        console.warn(`⚠️ USDA returned 0 usable results for "${query}" — falling back to Open Food Facts`);
      } else {
        console.warn(`⚠️ USDA non-OK status ${r.status} for "${query}" — falling back`);
      }
    } catch (e) { console.warn('USDA search failed:', e.message); }

    // 3. Fallback → Open Food Facts 키워드 검색
    const buildOffUrl = (page) =>
      `https://world.openfoodfacts.org/cgi/search.pl` +
      `?search_terms=${encodeURIComponent(query)}` +
      `&search_simple=1&action=process&json=1` +
      `&page_size=20&page=${page}&lc=en&cc=us`;

    function isEnglishName_(name) {
      if (!name) return false;
      const ascii = name.split('').filter(c => c.charCodeAt(0) < 128).length;
      return ascii / name.length >= 0.7;
    }

    try {
      const [r1, r2] = await Promise.all([
        fetchWithTimeout_(buildOffUrl(1), { headers: { 'User-Agent': 'MIE-Health/1.0 (kairoks.com)' } }, 8000),
        fetchWithTimeout_(buildOffUrl(2), { headers: { 'User-Agent': 'MIE-Health/1.0 (kairoks.com)' } }, 8000),
      ]);
      const products = [];
      for (const r of [r1, r2]) {
        if (r.ok) { const d = await r.json(); products.push(...(d.products || [])); }
      }
      const mapProduct = (p) => {
        const n = p.nutriments || {};
        return {
          food_name:            p.product_name_en || p.product_name || '',
          brand_name:           p.brands || '',
          calories_kcal:        +(n['energy-kcal_serving'] || n['energy-kcal_100g'] || 0),
          protein_g:            +(n['proteins_serving']    || n['proteins_100g']    || 0),
          carbs_g:              +(n['carbohydrates_serving']|| n['carbohydrates_100g']|| 0),
          fat_g:                +(n['fat_serving']         || n['fat_100g']         || 0),
          fiber_g:              +(n['fiber_serving']       || n['fiber_100g']       || 0),
          serving_qty:          1,
          serving_unit:         p.serving_size || '100g',
          serving_weight_grams: parseFloat(p.serving_quantity) || null,
          source:               'Open Food Facts',
        };
      };
      let foods = products.map(mapProduct).filter(f => f.food_name && f.calories_kcal > 0 && isEnglishName_(f.food_name));
      if (foods.length < 3) foods = products.map(mapProduct).filter(f => f.food_name && f.calories_kcal > 0);
      const seen = new Set();
      foods = foods.filter(f => { if (seen.has(f.food_name)) return false; seen.add(f.food_name); return true; }).slice(0, 8);
      if (foods.length > 0) {
        console.log(`✅ Food search "${query}" → Open Food Facts fallback (${foods.length} results)`);
        return res.status(200).json({ foods, query, source: 'Open Food Facts' });
      }
    } catch (e) { console.warn('Open Food Facts fallback failed:', e.message); }

    console.warn(`⚠️ Food search "${query}" → no results from any source`);
    res.status(200).json({ foods: [], query, source: null, message: 'No results found. Try a different search term.' });

  } catch (err) {
    console.error('Error in /api/health/food/search:', err);
    res.status(500).json({ error: 'FOOD_SEARCH_FAILED', message: err.message });
  }
});

