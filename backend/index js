        const fetch = (await import('node-fetch')).default;
        const scriptResp = await fetch(CALENDAR_SCRIPT_WEBHOOK, {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({
            trigger: 'calendar-push', email: userEmail, resourceState,
            timestamp: new Date().toISOString()
          }),
          timeout: 30000
        });
        const scriptStatus = scriptResp.status;
        const scriptBody   = await scriptResp.text().catch(() => '');
        if (scriptStatus >= 200 && scriptStatus < 300) {
          console.log(`✅ Calendar2Finance AS triggered successfully (HTTP ${scriptStatus})`);
        } else {
          console.error(`❌ Calendar2Finance AS trigger failed (HTTP ${scriptStatus}): ${scriptBody}`);
        }
      } catch (err) {
        console.error('Error triggering Calendar2Finance:', err.message || err);
