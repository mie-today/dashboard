app.get('/auth/google', (req, res) => {
  const client = createOAuth2Client(req);
  const returnTo = (typeof req.query.return_to === 'string') ? req.query.return_to : '';
  const state = isSafeReturnPath_(returnTo) ? returnTo : '';
  const url = client.generateAuthUrl({ access_type: 'offline', prompt: 'consent', scope: SCOPES, state: state });
  res.redirect(url);
});

app.get('/auth/google/callback', async (req, res) => {
  try {
    const code = req.query.code;
    if (!code) return res.status(400).send('Missing code');
    const client = createOAuth2Client(req);
    const { tokens } = await client.getToken(code);
    client.setCredentials(tokens);
    req.session.tokens = tokens;
    let userInfo = null;
    try { userInfo = await fetchUserInfo(client); } catch (e) { console.error('Error fetching user info:', e); }
    req.session.user = userInfo || null;
    try {
      const email = userInfo && (userInfo.email || userInfo.primaryEmail);
      if (tokens.refresh_token && email) {
        await saveRefreshTokenForEmail(email, tokens.refresh_token);
        console.log(`✓ Saved refresh token for ${email} (KMS=${!!KMS_KEY_NAME})`);
      } else if (email) {
        const existing = await getRefreshTokenForEmail(email);
        if (existing) { console.log(`✓ Using existing refresh token for ${email}`); }
        else          { console.warn(`⚠ No refresh token received for ${email}`); }
      }
      if (email) {
        try {
          await registerCalendarWatchForUser(email, client);
          console.log(`✅ Calendar watch registered at login for ${email}`);
        } catch (e) {
          console.error(`⚠️ Calendar watch registration failed for ${email}:`, e.message);
        }
      }
    } catch (e) { console.error('Failed saving refresh token to Firestore:', e); }
    // [return_to] state로 돌아온 값이 안전한 내부 경로면 그리로, 아니면 /dashboard로 폴백
    const returnState = req.query.state;
    const target = isSafeReturnPath_(returnState) ? (FRONTEND_ORIGIN + returnState) : (FRONTEND_ORIGIN + '/dashboard');
    res.redirect(target);
  } catch (err) {
    console.error('Error in /auth/google/callback:', err);
    res.status(500).send('Authentication error');
  }
});

app.post('/auth/logout', (req, res) => {
  try { req.session = null; } catch (err) { console.error('Error clearing session:', err); }
  res.status(200).json({ ok: true });
});

