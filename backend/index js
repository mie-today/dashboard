app.get('/api/me/health/records', async (req, res) => {
  try {
    if (!req.session || !req.session.tokens) return res.status(401).json({ error: 'NOT_CONNECTED' });
    const userInfo  = req.session.user || {};
    const userEmail = (userInfo.email || userInfo.primaryEmail || '').toLowerCase();
    if (!userEmail) return res.status(400).json({ error: 'NO_USER_EMAIL' });
    const typeFilter = (req.query.type || '').toLowerCase();
    const healthSheetId = await getHealthSheetId_(userEmail);
    const adminToken    = await getRefreshTokenForEmail(HEALTH_ADMIN);
    if (!adminToken) return res.status(500).json({ error: 'NO_ADMIN_TOKEN' });
    const adminClient = createOAuth2Client(null);
    adminClient.setCredentials({ refresh_token: adminToken });
    const sheets = google.sheets({ version: 'v4', auth: adminClient });
    const tabRes = await sheets.spreadsheets.values.get({ spreadsheetId: healthSheetId, range: 'Records!A:E' });
    const rows   = tabRes.data.values || [];
    const records = [];
    for (let r = 1; r < rows.length; r++) {
      const row = rows[r];
      if (!row || !row[0]) continue;
      const record_type = (row[1] || '').toString().trim();
      if (typeFilter && record_type !== typeFilter) continue;
      let data_parsed = {};
      try { data_parsed = JSON.parse(row[2] || '{}'); } catch (e) {}
      records.push({
        record_id:   (row[0] || '').toString().trim(),
        record_type,
        data:        data_parsed,
        created_at:  (row[3] || '').toString().trim(),
        updated_at:  (row[4] || '').toString().trim(),
        _sheet_row:  r + 1,
      });
    }
    res.set('Cache-Control', 'no-store');
    res.status(200).json({ records, count: records.length, type: typeFilter || 'all' });
  } catch (err) {
    console.error('Error in GET /api/me/health/records:', err);
    res.status(500).json({ error: 'RECORDS_FETCH_FAILED', message: err.message });
  }
});

