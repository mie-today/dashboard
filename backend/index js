    if (!amount)   return res.status(400).json({ error: 'MISSING_AMOUNT' });
    if (!category) return res.status(400).json({ error: 'MISSING_CATEGORY' });
    const validTypes = ['Income', 'Expenses', 'Savings'];
    if (!validTypes.includes(type)) return res.status(400).json({ error: 'INVALID_TYPE' });
    const userInfo  = req.session.user || {};
    const userEmail = (userInfo.email || userInfo.primaryEmail || '').toLowerCase();
    const financeSheetId = await getFinanceSheetId_(userEmail);
    const adminToken = await getRefreshTokenForEmail(FINANCE_ADMIN);
    if (!adminToken) return res.status(500).json({ error: 'NO_ADMIN_TOKEN' });
    const adminClient = createOAuth2Client(null);
    adminClient.setCredentials({ refresh_token: adminToken });
    const sheets = google.sheets({ version: 'v4', auth: adminClient });
    const today     = date || new Date().toISOString().slice(0, 10);
    const amountNum = parseFloat(amount);
    const rowData   = [ `'${today}`, amountNum, category, sublabel || '', '', 'Direct', notes || '', '' ];
    const appendRes = await sheets.spreadsheets.values.append({
      spreadsheetId: financeSheetId, range: `${type}!A1`,
      valueInputOption: 'USER_ENTERED', insertDataOption: 'INSERT_ROWS',
      requestBody: { values: [rowData] },
    });
    const updatedRange = (appendRes.data.updates || {}).updatedRange || '';
    const rowNumMatch  = updatedRange.match(/(\d+)$/);
    const rowNum       = rowNumMatch ? parseInt(rowNumMatch[1]) : 0;
    if (rowNum) {
      const formula = `=IFERROR(IF(B${rowNum}=0,"",B${rowNum}-VLOOKUP(C${rowNum},Baseline!A:B,2,0)),"-")`;
      await sheets.spreadsheets.values.update({
        spreadsheetId: financeSheetId, range: `${type}!E${rowNum}`,
        valueInputOption: 'USER_ENTERED', requestBody: { values: [[formula]] },
      });
    }
    let calendarEvent = null;
    let calendarReauthRequired = false;
    if (createCalendarEvent) {
      try {
        const userClient = createOAuth2Client(req);
        const calendar   = google.calendar({ version: 'v3', auth: userClient });
        const masterSheets = google.sheets({ version: 'v4', auth: adminClient });
        const masterRes    = await masterSheets.spreadsheets.values.get({ spreadsheetId: MASTER_SHEET_ID, range: 'UserInfo!A:O' });
        const masterRows   = masterRes.data.values || [];
        let   colorId      = null;
        const COLOR_MAP    = { lavender:'1',sage:'2',grape:'3',flamingo:'4',banana:'5',tangerine:'6',peacock:'7',graphite:'8',blueberry:'9',basil:'10',tomato:'11' };
        for (let r = 1; r < masterRows.length; r++) {
          if ((masterRows[r][2] || '').toString().trim().toLowerCase() === userEmail) {
            colorId = COLOR_MAP[(masterRows[r][14] || '').toString().trim().toLowerCase()] || null; break;
          }
        }
        const eventTitle = sublabel ? `${category} $${amountNum} | ${sublabel}` : `${category} $${amountNum}`;
        const eventBody  = { summary: eventTitle, description: notes || '', start: { date: today }, end: { date: today }, visibility: 'private' };
        if (colorId) eventBody.colorId = colorId;
        const calRes  = await calendar.events.insert({ calendarId: 'primary', requestBody: eventBody });
        calendarEvent = { id: calRes.data.id, htmlLink: calRes.data.htmlLink };
        if (rowNum && calendarEvent.id) {
          await sheets.spreadsheets.values.update({
            spreadsheetId: financeSheetId, range: `${type}!H${rowNum}`,
            valueInputOption: 'USER_ENTERED', requestBody: { values: [[calendarEvent.id]] },
          });
        }
      } catch (calErr) {
        console.error('Calendar event creation failed:', calErr.message);
        // [REAUTH_REQUIRED 신호] 트랜잭션(위 appendRes)은 이미 저장 성공했으므로
        // 전체 요청을 실패 처리하지 않고, 캘린더 파트만 실패했다는 신호를 응답에 실어 보낸다.
        if (isReauthRequiredError_(calErr)) calendarReauthRequired = true;
      }
    }
    res.status(200).json({
      ok: true, transaction: { date: today, amount: amountNum, category, sublabel: sublabel || '', notes: notes || '', source: 'Direct', type, row: rowNum },
      calendar_event: calendarEvent, calendar_reauth_required: calendarReauthRequired,
    });
  } catch (err) {
    console.error('Error in /api/me/finance/transaction:', err);
    res.status(500).json({ error: 'TRANSACTION_FAILED', message: err.message });
  }
});

