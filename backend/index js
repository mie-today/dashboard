app.post('/api/me/finance/needs-review/resolve', async (req, res) => {
  try {
    if (!req.session || !req.session.tokens) return res.status(401).json({ error: 'NOT_CONNECTED' });
    const { rowNumber, tabName, amount, category, sublabel, notes, date } = req.body || {};
    if (rowNumber === undefined) return res.status(400).json({ error: 'MISSING_ROW_NUMBER' });
    const TAB_MAP  = { income: 'Income', expenses: 'Expenses', savings: 'Savings' };
    const sheetTab = TAB_MAP[(tabName || '').toLowerCase()];
    if (!sheetTab) return res.status(400).json({ error: 'INVALID_TAB_NAME' });
    const userInfo  = req.session.user || {};
    const userEmail = (userInfo.email || userInfo.primaryEmail || '').toLowerCase();
    const financeSheetId = await getFinanceSheetId_(userEmail);
    const adminToken = await getRefreshTokenForEmail(FINANCE_ADMIN);
    if (!adminToken) return res.status(500).json({ error: 'NO_ADMIN_TOKEN' });
    const adminClient = createOAuth2Client(null);
    adminClient.setCredentials({ refresh_token: adminToken });
    const sheets = google.sheets({ version: 'v4', auth: adminClient });

    // Sync Log에서 해당 행을 읽어와 원본 내용(제목/eventId) 확보
    const logRes = await sheets.spreadsheets.values.get({ spreadsheetId: financeSheetId, range: `Sync Log!A${rowNumber}:I${rowNumber}` });
    const logRow = (logRes.data.values || [])[0];
    if (!logRow) return res.status(404).json({ error: 'ROW_NOT_FOUND' });
    const eventId = (logRow[8] || '').toString().trim(); // I열 — 없을 수 있음(과거 행)

    // 승인 → Finance 탭(Income/Expenses/Savings)에 새 행 append. writeFinanceRow_(Apps Script)와
    // 동일한 컬럼 구조(A:Date | B:Amount | C:Category | D:Sub-label | E:vs Budget | F:Source | G:Notes | H:Event ID) 유지.
    const rowDate = (date || '').toString().trim() || new Date().toISOString().slice(0, 10);
    const financeRow = [
      "'" + rowDate,
      parseFloat(amount) || 0,
      category || '',
      sublabel || '',
      '', // E: vs Budget — 기존 Apps Script처럼 VLOOKUP 수식은 여기선 생략(필요 시 후속 작업)
      'Calendar',
      notes || (logRow[2] || ''), // notes 미지정 시 Sync Log의 원본 제목을 그대로 사용
      eventId,
    ];
    await sheets.spreadsheets.values.append({
      spreadsheetId: financeSheetId, range: `${sheetTab}!A1`,
      valueInputOption: 'USER_ENTERED', insertDataOption: 'INSERT_ROWS',
      requestBody: { values: [financeRow] },
    });

    // Sync Log 상태를 RESOLVED로 변경(H열), 실제 반영된 tab을 G열에 기록
    await sheets.spreadsheets.values.batchUpdate({
      spreadsheetId: financeSheetId,
      requestBody: {
        valueInputOption: 'USER_ENTERED',
        data: [
          { range: `Sync Log!G${rowNumber}`, values: [[sheetTab]] },
          { range: `Sync Log!H${rowNumber}`, values: [['RESOLVED']] },
        ],
      },
    });

    res.status(200).json({ ok: true, rowNumber, tab: sheetTab });
  } catch (err) {
    console.error('Error in /api/me/finance/needs-review/resolve:', err);
    res.status(500).json({ error: 'NEEDS_REVIEW_RESOLVE_FAILED', message: err.message });
  }
});

