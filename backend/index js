    };
    if (due !== undefined) { patchBody.due = due || null; } else if (existing.due) { patchBody.due = existing.due; }
    if (patchBody.status === 'completed' && !existing.completed) { patchBody.completed = new Date().toISOString(); }
    else if (patchBody.status === 'needsAction') { patchBody.completed = null; }
    const result = await tasks.tasks.patch({ tasklist: listId, task: taskId, requestBody: patchBody });
