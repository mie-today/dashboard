// HEALTH MINI DISPLAY CONFIG API  [신규/확장 — Settings: Health 미니카드 표시 설정]
// UserInfo AD열 (index 29) — JSON 객체 문자열: {items:[], auto_items:bool, womens_mode:'auto'|'pregnancy'|'period'}
//   items       : 수동으로 고른 항목 키 목록. 비어있지 않으면 이게 최우선(자동감지 무시).
//   auto_items  : items가 비어있을 때만 의미 있음. true면 "이번 달에 그 항목 데이터가
//                 있는 것만" 항목별로 자동 표시. false(기본)면 12개(+womens) 전체 표시.
//   womens_mode : Women's 슬롯 안에서 무엇을 보여줄지 — 'auto'(데이터로 자동판단, 기본) |
//                 'pregnancy'(항상 임신 주차) | 'period'(항상 다음 생리 D-day).
//                 이 값은 Women's 슬롯 자체를 보이게/숨기게 하지 않는다 — 슬롯 표시 여부는
//                 오직 items/auto_items(위)로만 결정한다(숨기는 방법을 한 곳에만 두기로 함).
// [하위호환] 예전엔 이 컬럼에 배열만 저장했었다(예: '["glucose","weight"]'). 배열이면
// {items: 그 배열, auto_items:false, womens_mode:'auto'}로 취급한다.
// ============================================================================
const HEALTH_MINI_ITEM_KEYS = ['cals','steps','dist','activecal','water','weight','bp','hr','spo2','glucose','sleep','mood','womens'];
const WOMENS_MODE_VALUES = ['auto', 'pregnancy', 'period'];

function parseHealthDisplayConfigCell_(raw) {
  raw = (raw || '').toString().trim();
  const fallback = { items: [], auto_items: false, womens_mode: 'auto' };
  if (!raw) return fallback;
  let parsed;
  try { parsed = JSON.parse(raw); } catch (e) { return fallback; }
  if (Array.isArray(parsed)) {
    // 예전 형식(배열만) — 하위호환
    return { items: parsed.filter(k => HEALTH_MINI_ITEM_KEYS.includes(k)), auto_items: false, womens_mode: 'auto' };
  }
  if (parsed && typeof parsed === 'object') {
    return {
      items: Array.isArray(parsed.items) ? parsed.items.filter(k => HEALTH_MINI_ITEM_KEYS.includes(k)) : [],
      auto_items: !!parsed.auto_items,
      womens_mode: WOMENS_MODE_VALUES.includes(parsed.womens_mode) ? parsed.womens_mode : 'auto',
    };
  }
  return fallback;
}

