// ================== KMS INIT ==================
const { KeyManagementServiceClient } = require('@google-cloud/kms');
const kmsClient    = new KeyManagementServiceClient();
const KMS_KEY_NAME = process.env.KMS_KEY_NAME || '';

async function kmsEncrypt_(plaintext) {
  if (!KMS_KEY_NAME) return null;
  const [result] = await kmsClient.encrypt({
    name: KMS_KEY_NAME, plaintext: Buffer.from(String(plaintext), 'utf8'),
  });
  return result.ciphertext ? Buffer.from(result.ciphertext).toString('base64') : null;
}

async function kmsDecrypt_(ciphertextB64) {
  if (!KMS_KEY_NAME) return null;
  const [result] = await kmsClient.decrypt({
    name: KMS_KEY_NAME, ciphertext: Buffer.from(String(ciphertextB64), 'base64'),
  });
  return result.plaintext ? Buffer.from(result.plaintext).toString('utf8') : null;
}

async function saveRefreshTokenForEmail(email, refreshToken) {
  const safeEmail = String(email || '').trim().toLowerCase();
  if (!safeEmail || !refreshToken) return;
  let payload = { updatedAt: admin.firestore.FieldValue.serverTimestamp() };
  if (KMS_KEY_NAME) {
    const enc = await kmsEncrypt_(refreshToken);
    if (!enc) throw new Error('KMS encrypt returned empty ciphertext.');
    payload.refresh_token_enc = enc;
    payload.refresh_token     = admin.firestore.FieldValue.delete();
  } else {
    console.warn('KMS_KEY_NAME not set; storing refresh token in plaintext.');
    payload.refresh_token = refreshToken;
  }
  await db.collection(REFRESH_TOKEN_COLLECTION).doc(safeEmail).set(payload, { merge: true });
}

async function getRefreshTokenForEmail(email) {
  const safeEmail = String(email || '').trim().toLowerCase();
  if (!safeEmail) return null;
  const docRef = db.collection(REFRESH_TOKEN_COLLECTION).doc(safeEmail);
  const snap   = await docRef.get();
  if (!snap.exists) return null;
  const data = snap.data() || {};
  if (data.refresh_token_enc && KMS_KEY_NAME) {
    return await kmsDecrypt_(data.refresh_token_enc);
  }
  return data.refresh_token || null;
}

