    let rows;
    try {
      const r = await sheets.spreadsheets.values.get({ spreadsheetId: financeSheetId, range: 'Hybrid_Overrides!A:B' });
      rows = r.data.values || [];
    } catch (e) {
      // 탭이 아직 없음 — 신규 상태, 에러 아님
