// ============================================================================
// HYBRID OVERRIDE API
// Needs/Wants 양쪽으로 쓰일 수 있는 카테고리(예: Shopping - Clothing, Gym / Fitness)에 대해
// 사용자가 수동으로 N/W를 지정해두는 기능. Baseline 탭은 예산 변경 시 새 행을 append하는
// 이력(버전) 구조라 여기에 얹으면 값이 유실되므로, 같은 Finance 스프레드시트 안에
// 별도 탭(Hybrid_Overrides, 2컬럼: Category/Override)을 두고 이력 없이 덮어쓰기(upsert)만 한다.
// 탭이 아직 없으면 첫 저장 시 자동 생성한다(사용자가 미리 만들어뒀어도 문제 없음 — 있으면 그대로 사용).
// ============================================================================
const HYBRID_CATS = ['Shopping - Clothing', 'Gym / Fitness']; // miarvo_variant_b_up.html의 HYBRID_CATS와 동일하게 유지할 것

async function ensureHybridOverridesTab_(sheets, spreadsheetId) {
  const meta = await sheets.spreadsheets.get({ spreadsheetId });
  const exists = (meta.data.sheets || []).some(s => s.properties.title === 'Hybrid_Overrides');
  if (exists) return;
  await sheets.spreadsheets.batchUpdate({
    spreadsheetId,
    requestBody: { requests: [{ addSheet: { properties: { title: 'Hybrid_Overrides' } } }] },
  });
  await sheets.spreadsheets.values.update({
    spreadsheetId, range: 'Hybrid_Overrides!A1:B1',
    valueInputOption: 'USER_ENTERED', requestBody: { values: [['Category', 'Override']] },
  });
}

