const eventColorCache = new Map();
async function getEventColorById(calendar, colorId) {
  if (!colorId) return null;
  if (eventColorCache.has(colorId)) return eventColorCache.get(colorId);
  try {
    const colorsRes   = await calendar.colors.get();
    const eventColors = colorsRes.data.event || {};
    const hexColor    = eventColors[colorId] ? eventColors[colorId].background : null;
    eventColorCache.set(colorId, hexColor);
    return hexColor;
  } catch (err) { console.error(`Error fetching color for colorId ${colorId}:`, err); return null; }
}

