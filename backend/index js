// PUT /api/me/health/profile
// POST /api/me/health/profile  [v4.0] panel-infogoal 호환
// ============================================================================
async function handleHealthProfileSave_(req, res) {
  try {
    if (!req.session || !req.session.tokens) return res.status(401).json({ error: 'NOT_CONNECTED' });
    const { type, data } = req.body || {};
    if (!type || !data) return res.status(400).json({ error: 'MISSING_TYPE_OR_DATA' });
    if (!['baseline','goal'].includes(type)) return res.status(400).json({ error: 'INVALID_TYPE' });
    const userInfo  = req.session.user || {};
    const userEmail = (userInfo.email || userInfo.primaryEmail || '').toLowerCase();
    const healthSheetId = await getHealthSheetId_(userEmail);
    const adminToken    = await getRefreshTokenForEmail(HEALTH_ADMIN);
    if (!adminToken) return res.status(500).json({ error: 'NO_ADMIN_TOKEN' });
    const adminClient = createOAuth2Client(null);
    adminClient.setCredentials({ refresh_token: adminToken });
    const sheets = google.sheets({ version: 'v4', auth: adminClient });
    const converted = type === 'baseline' ? convertUnits_(data, 'health') : data;
    if (type === 'baseline' && converted.weight_kg && converted.height_cm && converted.age && converted.sex) {
      const sex = (converted.sex || '').toLowerCase();
      const bmr = sex === 'male'
        ? 10 * converted.weight_kg + 6.25 * converted.height_cm - 5 * converted.age + 5
        : 10 * converted.weight_kg + 6.25 * converted.height_cm - 5 * converted.age - 161;
      converted.bmr_kcal  = +bmr.toFixed(0);
      converted.tdee_kcal = +(bmr * (parseFloat(converted.activity_level) || 1.55)).toFixed(0);
    }
    const newRow = buildHealthRow_(type, converted);
    if (!newRow.length) return res.status(400).json({ error: 'INVALID_DATA' });
    await sheets.spreadsheets.values.append({
      spreadsheetId: healthSheetId, range: `${HEALTH_TAB_MAP[type]}!A:A`,
      valueInputOption: 'USER_ENTERED', insertDataOption: 'INSERT_ROWS',
      requestBody: { values: [newRow] },
    });
    console.log(`✅ Health profile (${type}) saved for ${userEmail}`);
    res.status(200).json({ ok: true, type, data: converted });
  } catch (err) {
    console.error('Error in health/profile save:', err);
    res.status(500).json({ error: 'HEALTH_PROFILE_SAVE_FAILED', message: err.message });
  }
}

