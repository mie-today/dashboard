app.post('/api/pubsub/gmail-push', async (req, res) => {
  res.status(200).json({ ok: true });
  try {
    const body = req.body;
    if (!body || !body.message || !body.message.data) {
      console.log('📨 Pub/Sub push received but no message data — ignoring');
      return;
    }
    const decoded = Buffer.from(body.message.data, 'base64').toString('utf8');
    let pushData;
    try { pushData = JSON.parse(decoded); }
    catch (e) { console.log('📨 Pub/Sub message not JSON — ignoring:', decoded); return; }
    const { emailAddress, historyId } = pushData;
    console.log(`📨 Gmail push received for: ${emailAddress} (historyId: ${historyId})`);
    if (!SCRIPT_WEBHOOK) {
      console.error('❌ APPS_SCRIPT_WEBHOOK_URL not set — cannot trigger processAll()');
      return;
    }
    const fetch = (await import('node-fetch')).default;
    console.log('🚀 Triggering Apps Script processAll() via webhook...');
    const scriptResp = await fetch(SCRIPT_WEBHOOK, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ trigger: 'gmail-push', email: emailAddress, historyId }),
      timeout: 30000
    });
    const scriptStatus = scriptResp.status;
    const scriptBody   = await scriptResp.text().catch(() => '');
    if (scriptStatus >= 200 && scriptStatus < 300) {
      console.log(`✅ Apps Script triggered successfully (HTTP ${scriptStatus})`);
      // [sync-status] Apps Script 웹훅 호출이 성공적으로 끝난 시점을 "이 계정에 대한
      // gmail-push 처리가 마지막으로 성공한 시각"으로 기록한다. 이 값은 "이 메시지가
      // 처리 완료됐다"는 정확한 신호는 아니고, 다른 메일 때문에 갱신됐을 수도 있는
      // 힌트일 뿐이다 — 프론트에서 대략적인 폴링용으로만 사용한다.
      try {
        const safeEmail = (emailAddress || '').toString().trim().toLowerCase();
        if (safeEmail) {
          await db.collection('sync_status').doc(safeEmail).set({
            email: safeEmail,
            lastSyncAt: admin.firestore.FieldValue.serverTimestamp(),
          }, { merge: true });
        }
      } catch (syncErr) { console.error('Failed to record sync_status:', syncErr.message || syncErr); }
    } else {
      console.error(`❌ Apps Script trigger failed (HTTP ${scriptStatus}): ${scriptBody}`);
    }
  } catch (err) { console.error('Error processing Pub/Sub push:', err.message || err); }
});

