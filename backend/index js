app.post('/api/me/access-token', async (req, res) => {
  try {
    if (APPSCRIPT_API_KEY) {
      const key = req.get('X-Mie-Api-Key') || '';
      if (key !== APPSCRIPT_API_KEY) return res.status(403).json({ error: 'FORBIDDEN' });
    } else {
      console.warn('⚠️ APPSCRIPT_API_KEY not set — /api/me/access-token is UNPROTECTED (anyone with an email can mint a live access token).');
    }
    const email = req.body && req.body.email ? String(req.body.email).trim().toLowerCase() : '';
    if (!email) return res.status(400).json({ error: 'MISSING_EMAIL' });
    const refreshToken = await getRefreshTokenForEmail(email);
    if (!refreshToken) {
      return res.status(404).json({
        error: 'NO_REFRESH_TOKEN_FOR_EMAIL',
        message: `No refresh token found for ${email}. User must sign in through dashboard first.`
      });
    }
    const client = createOAuth2Client(null);
    client.setCredentials({ refresh_token: refreshToken });
    const accessResp  = await client.getAccessToken();
    const accessToken = (typeof accessResp === 'string') ? accessResp :
                        (accessResp && accessResp.token) ? accessResp.token : null;
    if (!accessToken) return res.status(500).json({ error: 'ACCESS_TOKEN_EMPTY' });
    res.status(200).json({ access_token: accessToken, token_type: 'Bearer' });
  } catch (err) {
    console.error('Error in /api/me/access-token:', err);
    res.status(500).json({ error: 'ACCESS_TOKEN_MINT_FAILED', details: err.message || String(err) });
  }
