// ================== HELPER: OAuth2 CLIENT ==================
function createOAuth2Client(reqOrNull) {
  const client = new google.auth.OAuth2(GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI);
  if (reqOrNull && reqOrNull.session && reqOrNull.session.tokens) {
    client.setCredentials(reqOrNull.session.tokens);
  }
  return client;
}

// [return_to 안전성 검증] /auth/google?return_to=... 로 들어온 값이 우리 사이트 내부의
// 상대 경로인지 확인. 외부 도메인으로 리다이렉트되는 오픈 리다이렉트 취약점을 막기 위해
// '/'로 시작하고, '//'(프로토콜 상대 URL)나 '://'(절대 URL), 역슬래시가 없는 경우만 허용.
function isSafeReturnPath_(p) {
  if (typeof p !== 'string' || !p) return false;
  if (!p.startsWith('/')) return false;
  if (p.startsWith('//')) return false;
  if (p.includes('://')) return false;
  if (p.includes('\\')) return false;
  return true;
}

// [REAUTH_REQUIRED 감지] 사용자 본인 세션 토큰(createOAuth2Client(req))으로 Google API를
// 호출하는 라우트에서 "스코프 부족" 또는 "토큰 무효/만료(invalid_grant)"로 실패했는지 판별.
// 둘 다 사용자 입장에선 해결책이 동일(재연결)하므로 하나의 신호로 묶는다.
function isReauthRequiredError_(err) {
  const msg = ((err && err.message) || '').toLowerCase();
  return !!(err && (
    err.code === 401 ||
    (err.code === 403 && (msg.includes('insufficient') || msg.includes('scope'))) ||
    msg.includes('invalid_grant') ||
    msg.includes('invalid_token') ||
    msg.includes('token has been expired or revoked')
  ));
}

async function fetchUserInfo(authClient) {
  const oauth2   = google.oauth2({ version: 'v2', auth: authClient });
  const { data } = await oauth2.userinfo.get();
  return data;
}

async function listAllEventsForCalendar(calendar, calendarId, baseOptions) {
  const all = [];
  let pageToken = null;
  do {
    const res = await calendar.events.list({ calendarId, ...baseOptions, pageToken });
    all.push(...(res.data.items || []));
    pageToken = res.data.nextPageToken || null;
  } while (pageToken);
  return all;
}

