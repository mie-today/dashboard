        spreadsheetId: financeSheetId, range: 'Hybrid_Overrides!A:B',
        valueInputOption: 'USER_ENTERED', insertDataOption: 'INSERT_ROWS',
        requestBody: { values: [[cat, val]] },
      });
    }
    res.status(200).json({ ok: true, category: cat, value: val });
  } catch (err) {
    console.error('Error in /api/me/finance/hybrid-overrides POST:', err);
    res.status(500).json({ error: 'HYBRID_OVERRIDES_SAVE_FAILED', message: err.message });
  }
});

// ============================================================================
// DASHBOARD PREFS API  [신규 — General Settings: Overview 대시보드 표시 범위]
// UserInfo AC열 (index 28), 헤더명 "Overview Type" (사용자가 시트에서 직접 리네임함).
// 값: 'simple' | 'finance' | 'health' | 'all'
//   finance / health 각각: 'off'(항상 숨김) | 'on'(항상 표시) | 'auto'(이번 달 데이터 있을 때만)
//   기본값은 둘 다 'auto'.
// [재구조화] 예전엔 AC열에 'simple'/'finance'/'health'/'all' 문자열 하나만 저장했는데,
// 그 4가지 조합만으로는 "Finance는 자동, Health는 항상 끔" 같은 조합을 표현할 수 없어서
// Finance/Health를 독립된 2개 값으로 쪼갰다. 같은 AC열에 JSON으로 저장한다(컬럼 안 늘림).
// [하위호환] 시트에 이미 예전 방식 문자열(예: "all", "finance", 대문자 "ALL" 등)이 들어있는
// 계정도 있으므로, JSON 파싱이 안 되면 예전 문자열로 보고 아래 매핑대로 변환해서 응답한다:
//   simple → {finance:'auto',health:'auto'} / finance → {finance:'on',health:'off'}
//   health → {finance:'off',health:'on'}    / all     → {finance:'on',health:'on'}
// 저장은 항상 새 JSON 형식으로 하므로, 한 번 저장하고 나면 그 계정은 새 형식으로 넘어간다.
// ============================================================================
const DASHBOARD_DISPLAY_VALUES = ['off', 'on', 'auto'];
const LEGACY_OVERVIEW_TYPE_MAP = {
  simple:  { finance: 'auto', health: 'auto' },
  finance: { finance: 'on',   health: 'off'  },
  health:  { finance: 'off',  health: 'on'   },
  all:     { finance: 'on',   health: 'on'   },
};
function parseDashboardDisplayCell_(raw) {
  raw = (raw || '').toString().trim();
  if (!raw) return { finance: 'auto', health: 'auto' };
  try {
    const parsed = JSON.parse(raw);
    if (parsed && DASHBOARD_DISPLAY_VALUES.includes(parsed.finance) && DASHBOARD_DISPLAY_VALUES.includes(parsed.health)) {
      return { finance: parsed.finance, health: parsed.health };
    }
  } catch (e) { /* JSON 아니면 아래 레거시 문자열 처리로 */ }
  const legacy = LEGACY_OVERVIEW_TYPE_MAP[raw.toLowerCase()];
  return legacy || { finance: 'auto', health: 'auto' };
}

