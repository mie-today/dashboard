function parseBaselineRows_(rows, targetYearMonth) {
  const [ty, tm] = targetYearMonth.split('-').map(Number);
  const targetDate = new Date(ty, tm, 0);
  const SECTION_MAP = {
    'Salary': 'INCOME', 'Freelance': 'INCOME', 'Sales': 'INCOME', 'Other Income': 'INCOME',
    'Rent / Mortgage': 'EXPENSES', 'Groceries': 'EXPENSES', 'Household Essentials': 'EXPENSES',
    "Renter's / Home Insurance": 'EXPENSES', 'Gas & Electricity': 'EXPENSES', 'Water / Sewer': 'EXPENSES',
    'Internet': 'EXPENSES', 'Cell Phone': 'EXPENSES', 'Health Insurance': 'EXPENSES',
    'Car Payment': 'EXPENSES', 'Car Insurance': 'EXPENSES', 'Tax': 'EXPENSES',
    'Credit Card Payment': 'EXPENSES', 'Transportation - Public Transit': 'EXPENSES',
    'Transportation - Rideshare': 'EXPENSES', 'Transportation - Gas / EV': 'EXPENSES',
    'Transportation - Parking': 'EXPENSES', 'Medical / Co-payment': 'EXPENSES',
    'Pharmacy': 'EXPENSES', 'Gym / Fitness': 'EXPENSES', 'Education': 'EXPENSES',
    'Gift / Donation': 'EXPENSES', 'Beauty & Personal Care': 'EXPENSES',
    'Shopping - Clothing': 'EXPENSES', 'Shopping - Electronics': 'EXPENSES',
    'Snacks & Coffee': 'EXPENSES', 'Dining Out': 'EXPENSES', 'Entertainment': 'EXPENSES',
    'Subscriptions': 'EXPENSES', 'Hobby': 'EXPENSES', 'Travel': 'EXPENSES',
    'Other - Needs': 'EXPENSES', 'Other - Wants': 'EXPENSES',
    'Savings Transfer': 'SAVINGS', 'Emergency Fund': 'SAVINGS',
    'Retirement': 'SAVINGS', 'Investment': 'SAVINGS',
  };
  const SKIP_PATTERNS = ['Category', 'MIE', 'Edit', 'Monthly Budget', 'Annual Budget'];
  const resultMap = {};
  for (const row of rows) {
    if (!row || !row[0]) continue;
    const category = row[0].toString().trim();
    if (!category) continue;
    if (SKIP_PATTERNS.some(p => category.startsWith(p))) continue;
    const linkedSheet = (row[6] || '').toString().trim();
    if (!linkedSheet) continue;
    const section = SECTION_MAP[category];
    if (!section) continue;
    const effectiveFrom = (row[4] || '2000-01-01').toString().trim().substring(0, 10);
    const effDate = new Date(effectiveFrom);
    if (effDate > targetDate) continue;
    const monthly_budget = parseFloat((row[1] || '0').toString().replace(/[$,\s]/g, '')) || 0;
    const annual_budget  = parseFloat((row[2] || '0').toString().replace(/[$,\s]/g, '')) || 0;
    const notes          = (row[3] || '').toString().trim();
    if (!resultMap[category] || new Date(resultMap[category].effective_from) <= effDate) {
      resultMap[category] = {
        section, category, monthly_budget, annual_budget,
        effective_from: effectiveFrom, notes, linked_sheet: linkedSheet,
      };
    }
  }
  return Object.values(resultMap);
}

function parseTransactionRows_(rows, targetYearMonth) {
  const result = [];
  for (let r = 3; r < rows.length; r++) {
    const row = rows[r];
    if (!row || !row[0]) continue;
    const dateRaw = (row[0] || '').toString().trim();
    if (!dateRaw || dateRaw.length < 7) continue;
    const rowYM = dateRaw.substring(0, 7);
    if (targetYearMonth && rowYM !== targetYearMonth) continue;
    const amount = parseFloat((row[1] || '0').toString().replace(/[$,\s]/g, '')) || 0;
    if (amount === 0) continue;
    result.push({
      date:       dateRaw.substring(0, 10),
      amount,
      category:   (row[2] || '').toString().trim(),
      sublabel:   (row[3] || '').toString().trim(),
      vs_budget:  parseFloat((row[4] || '0').toString().replace(/[$,\s]/g, '')) || null,
      source:     (row[5] || 'Direct').toString().trim(),
      notes:      (row[6] || '').toString().trim(),
      event_id:   (row[7] || '').toString().trim(),
      _sheet_row: r + 1,
    });
  }
  return result;
}

function buildSummary_(income, expenses, savings, baseline) {
  const totalIncome   = income.reduce((s, r) => s + r.amount, 0);
  const totalExpenses = expenses.reduce((s, r) => s + r.amount, 0);
  const totalSavings  = savings.reduce((s, r) => s + r.amount, 0);
  const incomeBaseline   = baseline.filter(b => b.section === 'INCOME').reduce((s, b) => s + b.monthly_budget, 0);
  const expensesBaseline = baseline.filter(b => b.section === 'EXPENSES').reduce((s, b) => s + b.monthly_budget, 0);
  const savingsBaseline  = baseline.filter(b => b.section === 'SAVINGS').reduce((s, b) => s + b.monthly_budget, 0);
  return {
    income:   { actual: totalIncome,   budget: incomeBaseline,   diff: totalIncome - incomeBaseline },
    expenses: { actual: totalExpenses, budget: expensesBaseline, diff: totalExpenses - expensesBaseline },
    savings:  { actual: totalSavings,  budget: savingsBaseline,  diff: totalSavings - savingsBaseline },
    remaining: totalIncome - totalExpenses - totalSavings,
  };
}

app.get('/api/me/finance', async (req, res) => {
  try {
    if (!req.session || !req.session.tokens) return res.status(401).json({ error: 'NOT_CONNECTED' });
    const now        = new Date();
    const defaultYM  = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
    const targetYM   = (req.query.month || defaultYM).substring(0, 7);
    const ytdMode    = req.query.ytd === 'true';
    const targetYear = targetYM.substring(0, 4);
    const userInfo  = req.session.user || {};
    const userEmail = (userInfo.email || userInfo.primaryEmail || '').toLowerCase();
    if (!userEmail) return res.status(400).json({ error: 'NO_USER_EMAIL' });
    const financeSheetId = await getFinanceSheetId_(userEmail);
    const adminToken = await getRefreshTokenForEmail(FINANCE_ADMIN);
    if (!adminToken) return res.status(500).json({ error: 'NO_ADMIN_TOKEN' });
    const adminClient = createOAuth2Client(null);
    adminClient.setCredentials({ refresh_token: adminToken });
    const sheets = google.sheets({ version: 'v4', auth: adminClient });
    const [baselineRes, incomeRes, expensesRes, savingsRes] = await Promise.all([
      sheets.spreadsheets.values.get({ spreadsheetId: financeSheetId, range: 'Baseline!A:G' }),
      sheets.spreadsheets.values.get({ spreadsheetId: financeSheetId, range: 'Income!A:H' }),
      sheets.spreadsheets.values.get({ spreadsheetId: financeSheetId, range: 'Expenses!A:H' }),
      sheets.spreadsheets.values.get({ spreadsheetId: financeSheetId, range: 'Savings!A:H' }),
    ]);
    const filterYM   = ytdMode ? null : targetYM;
    const baselineYM = ytdMode ? `${targetYear}-01` : targetYM;
    const baseline = parseBaselineRows_(baselineRes.data.values || [], baselineYM);
    const income   = parseTransactionRows_(incomeRes.data.values   || [], filterYM);
    const expenses = parseTransactionRows_(expensesRes.data.values  || [], filterYM);
    const savings  = parseTransactionRows_(savingsRes.data.values   || [], filterYM);
    const summary  = buildSummary_(income, expenses, savings, baseline);
    res.set('Cache-Control', 'no-store');
    res.status(200).json({ month: targetYM, ytd: ytdMode, year: targetYear, summary, baseline, income, expenses, savings });
  } catch (err) {
    console.error('Error in /api/me/finance:', err);
    res.status(500).json({ error: 'FINANCE_FETCH_FAILED', message: err.message });
  }
});

