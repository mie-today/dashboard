app.post('/api/me/health/log/edit', async (req, res) => {
  try {
    if (!req.session || !req.session.tokens) return res.status(401).json({ error: 'NOT_CONNECTED' });
    const { tab, row_idx, sheet_row, data } = req.body || {};
    if (!tab || !data || !HEALTH_TAB_MAP[tab] || (row_idx === undefined && sheet_row === undefined)) {
      return res.status(400).json({ error: 'MISSING_OR_INVALID_PARAMS' });
    }
    const userInfo  = req.session.user || {};
    const userEmail = (userInfo.email || userInfo.primaryEmail || '').toLowerCase();
    const healthSheetId = await getHealthSheetId_(userEmail);
    const adminToken    = await getRefreshTokenForEmail(HEALTH_ADMIN);
    if (!adminToken) return res.status(500).json({ error: 'NO_ADMIN_TOKEN' });
    const adminClient = createOAuth2Client(null);
    adminClient.setCredentials({ refresh_token: adminToken });
    const sheets   = google.sheets({ version: 'v4', auth: adminClient });
    const sheetTab = HEALTH_TAB_MAP[tab];

    // [v4.4] sheet_row(실제 시트 행 번호, GET 응답의 _sheet_row 그대로)가 오면 이걸 그대로 씀 —
    // row_idx(탭 전체에서 몇 번째 비어있지 않은 행인지 다시 세는 방식)는 날짜 필터링 없이 세다 보니
    // 포맷 안내용 행(예: Women 탭 4행 "YYYY-MM-DD")까지 세어져 어긋날 수 있는 알려진 취약점이라,
    // 새 호출부는 전부 sheet_row를 쓰도록 전환. row_idx는 옛 호출부 호환을 위해 그대로 남겨둠.
    let sheetRowNumber = null;
    if (sheet_row !== undefined) {
      sheetRowNumber = parseInt(sheet_row);
      if (!sheetRowNumber || sheetRowNumber < 4) return res.status(400).json({ error: 'INVALID_SHEET_ROW' });
    } else {
      const tabRes = await sheets.spreadsheets.values.get({ spreadsheetId: healthSheetId, range: `${sheetTab}!A:A` });
      const rows   = tabRes.data.values || [];
      let matchCount = 0;
      for (let r = 3; r < rows.length; r++) {
        if (!rows[r] || !rows[r][0]) continue;
        if (matchCount === parseInt(row_idx)) { sheetRowNumber = r + 1; break; }
        matchCount++;
      }
    }
    if (!sheetRowNumber) return res.status(404).json({ error: 'ROW_NOT_FOUND' });
    const converted = convertUnits_({ ...data }, tab);
    await sheets.spreadsheets.values.update({
      spreadsheetId: healthSheetId, range: `${sheetTab}!A${sheetRowNumber}`,
      valueInputOption: 'USER_ENTERED', requestBody: { values: [buildHealthRow_(tab, converted)] },
    });
    res.status(200).json({ ok: true, tab, sheet_row: sheetRowNumber, data: converted });
  } catch (err) {
    console.error('Error in /api/me/health/log/edit:', err);
    res.status(500).json({ error: 'HEALTH_EDIT_FAILED', message: err.message });
  }
});

