// ============================================================================

const HEALTH_ADMIN = 'rachel@kairoks.com';

async function getHealthSheetId_(userEmail) {
  const adminToken = await getRefreshTokenForEmail(HEALTH_ADMIN);
  if (!adminToken) throw new Error('No admin refresh token');
  const adminClient = createOAuth2Client(null);
  adminClient.setCredentials({ refresh_token: adminToken });
  const sheets = google.sheets({ version: 'v4', auth: adminClient });
  const res  = await sheets.spreadsheets.values.get({ spreadsheetId: MASTER_SHEET_ID, range: 'UserInfo!A:Z' });
  const rows = res.data.values || [];
  for (let r = 1; r < rows.length; r++) {
    const row      = rows[r];
    const rowEmail = (row[2] || '').toString().trim().toLowerCase();
    if (rowEmail === userEmail.toLowerCase()) {
      const raw = (row[25] || '').toString().trim();
      if (!raw) throw new Error(`Health Sheet ID not set for ${userEmail}`);
      const m = raw.match(/\/spreadsheets\/d\/([a-zA-Z0-9_-]+)/);
      return m ? m[1] : raw;
    }
  }
  throw new Error(`User ${userEmail} not found in Master Sheet`);
}

function convertUnits_(data, tab) {
  const d = { ...data };
  if (tab === 'food') {
    if (d.protein_g !== undefined) d.protein_oz = +(d.protein_g * 0.035274).toFixed(3);
    if (d.carbs_g   !== undefined) d.carbs_oz   = +(d.carbs_g   * 0.035274).toFixed(3);
    if (d.fat_g     !== undefined) d.fat_oz     = +(d.fat_g     * 0.035274).toFixed(3);
    if (d.fiber_g   !== undefined) d.fiber_oz   = +(d.fiber_g   * 0.035274).toFixed(3);
    if (d.protein_oz !== undefined && d.protein_g === undefined) d.protein_g = +(d.protein_oz / 0.035274).toFixed(1);
    if (d.carbs_oz   !== undefined && d.carbs_g   === undefined) d.carbs_g   = +(d.carbs_oz   / 0.035274).toFixed(1);
    if (d.fat_oz     !== undefined && d.fat_g     === undefined) d.fat_g     = +(d.fat_oz     / 0.035274).toFixed(1);
    if (d.fiber_oz   !== undefined && d.fiber_g   === undefined) d.fiber_g   = +(d.fiber_oz   / 0.035274).toFixed(1);
  }
  if (tab === 'activity') {
    if (d.weight_kg   !== undefined) d.weight_lb   = +(d.weight_kg   * 2.20462).toFixed(1);
    if (d.distance_km !== undefined) d.distance_mi = +(d.distance_km * 0.621371).toFixed(2);
    if (d.weight_lb   !== undefined && d.weight_kg   === undefined) d.weight_kg  = +(d.weight_lb  / 2.20462).toFixed(1);
    if (d.distance_mi !== undefined && d.distance_km === undefined) d.distance_km = +(d.distance_mi / 0.621371).toFixed(2);
  }
  if (tab === 'health') {
    if (d.weight_kg !== undefined) d.weight_lb = +(d.weight_kg * 2.20462).toFixed(1);
    if (d.weight_lb !== undefined && d.weight_kg === undefined) d.weight_kg = +(d.weight_lb / 2.20462).toFixed(1);
    if (d.height_cm !== undefined) { d.height_ft = Math.floor(d.height_cm / 30.48); d.height_in = +((d.height_cm / 2.54) % 12).toFixed(1); }
    if (d.glucose_mgdl     !== undefined) d.glucose_mmol     = +(d.glucose_mgdl     / 18.0182).toFixed(1);
    if (d.temperature_c    !== undefined) d.temperature_f    = +(d.temperature_c    * 9/5 + 32).toFixed(1);
    if (d.temperature_f    !== undefined && d.temperature_c    === undefined) d.temperature_c    = +((d.temperature_f - 32) * 5/9).toFixed(1);
    if (d.cholesterol_mgdl !== undefined) d.cholesterol_mmol = +(d.cholesterol_mgdl * 0.0259).toFixed(2);
    if (d.cholesterol_mmol !== undefined && d.cholesterol_mgdl === undefined) d.cholesterol_mgdl = +(d.cholesterol_mmol / 0.0259).toFixed(0);
    if (d.muscle_mass_kg   !== undefined) d.muscle_mass_lb   = +(d.muscle_mass_kg   * 2.20462).toFixed(1);
    if (d.weight_kg !== undefined && d.height_cm !== undefined && d.sex) {
      const sex = (d.sex || '').toLowerCase();
      const leanMass = sex === 'male'
        ? 0.407 * d.weight_kg + 0.267 * d.height_cm - 19.2
        : 0.252 * d.weight_kg + 0.473 * d.height_cm - 48.3;
      d.lean_mass_kg_boer = +leanMass.toFixed(1);
      d.lean_mass_lb      = +(leanMass * 2.20462).toFixed(1);
      if (d.manual_body_fat_pct !== undefined && d.manual_body_fat_pct !== '') {
        d.body_fat_pct = +parseFloat(d.manual_body_fat_pct).toFixed(1);
      } else {
        d.body_fat_kg  = +(d.weight_kg - leanMass).toFixed(1);
        d.body_fat_pct = +((d.weight_kg - leanMass) / d.weight_kg * 100).toFixed(1);
      }
      if (d.manual_muscle_mass_kg !== undefined && d.manual_muscle_mass_kg !== '') {
        d.muscle_mass_kg = +parseFloat(d.manual_muscle_mass_kg).toFixed(1);
        d.muscle_mass_lb = +(d.muscle_mass_kg * 2.20462).toFixed(1);
      } else {
        const ratio = sex === 'male' ? 0.45 : 0.30;
        d.muscle_mass_kg = +(d.weight_kg * ratio).toFixed(1);
        d.muscle_mass_lb = +(d.muscle_mass_kg * 2.20462).toFixed(1);
      }
      const hm = d.height_cm / 100;
      d.bmi = +(d.weight_kg / (hm * hm)).toFixed(1);
    }
  }
  // [v4.0] water 단위 변환
  if (tab === 'water') {
    if (d.amount_ml !== undefined) d.amount_floz = +(d.amount_ml * 0.033814).toFixed(1);
    if (d.amount_floz !== undefined && d.amount_ml === undefined) d.amount_ml = +(d.amount_floz / 0.033814).toFixed(0);
  }
  return d;
}

function calcActivityCalories_(met, weightKg, durationMin) {
  if (!met || !weightKg || !durationMin) return null;
  return +((met * weightKg * durationMin / 60)).toFixed(0);
}

function matchesPeriod_(dateRaw, targetDate, period) {
  const d = dateRaw.substring(0, 10);
  if (period === 'daily')   return d === targetDate;
  if (period === 'weekly')  { const diff = (new Date(targetDate) - new Date(d)) / (1000*60*60*24); return diff >= 0 && diff < 7; }
  if (period === 'monthly') return d.substring(0, 7) === targetDate.substring(0, 7);
  if (period === 'yearly')  return d.substring(0, 4) === targetDate.substring(0, 4); // [신규] Women's History의 Monthly/Yearly/All에 쓰임
  if (period === 'all')     return true; // [v4.1] 전체 이력 조회용 — 명시적 지원 표시(동작은 기존 fallback과 동일)
  return true;
}

// ============================================================================
// parseHealthRows_ — 탭별 시트 데이터 파싱
// [v4.0] health(Body) 27col, sleep add_to_calendar, mood energy_level_1to5,
//        water, medication, womens, womens_bp, womens_mood, pregnancy 탭 추가
// ============================================================================
function parseHealthRows_(rows, tabName, targetDate, period) {
  const result = [];
  for (let r = 3; r < rows.length; r++) {
    const row = rows[r];
    if (!row || !row[0]) continue;
    const dateRaw = (row[0] || '').toString().trim();
    if (!dateRaw || dateRaw.length < 10) continue;
    if (!matchesPeriod_(dateRaw, targetDate, period)) continue;
    const entry = { _sheet_row: r + 1, stamp_date: dateRaw };

    if (tabName === 'food') {
      entry.meal_time     = (row[1]  || '').toString().trim();
      entry.food_name     = (row[2]  || '').toString().trim();
      entry.calories_kcal = parseFloat((row[3]  || '0').toString().replace(/[,$\s]/g,'')) || 0;
      entry.protein_g  = parseFloat(row[4])  || 0; entry.protein_oz = parseFloat(row[5])  || 0;
      entry.carbs_g    = parseFloat(row[6])  || 0; entry.carbs_oz   = parseFloat(row[7])  || 0;
      entry.fat_g      = parseFloat(row[8])  || 0; entry.fat_oz     = parseFloat(row[9])  || 0;
      entry.fiber_g    = parseFloat(row[10]) || 0; entry.fiber_oz   = parseFloat(row[11]) || 0;
      entry.source     = (row[12] || 'Manual').toString().trim();
      entry.notes      = (row[13] || '').toString().trim();
      entry.unit_pref  = (row[14] || 'metric').toString().trim();

    } else if (tabName === 'activity') {
      // [v4.1] 컬럼 순서 수정 — 실제 Activity 시트 헤더(A:stamp_date B:category C:type
      // D:duration_min E:sets F:reps G:weight_per_set_kg H:distance_km I:steps
      // J:calories_burned_kcal K:met_value L:add_to_calendar M:unit_pref N:notes, 14컬럼)를
      // 기준으로 재정렬함. 기존 코드는 sets/reps/weight_kg/weight_lb가 duration_min보다
      // 먼저 오고 distance_mi 컬럼이 별도로 있는 16컬럼 레이아웃을 가정했으나, 실제 시트는
      // duration_min이 두 번째(D열)에 오고 weight는 kg 단일 컬럼, distance_mi 컬럼은 아예
      // 없음 — 이 불일치 때문에 steps 값이 "distance"로, calories 값이 "distance_mi"로
      // 표시되는 등 프론트 Activity Entry 화면 전체가 밀려서 잘못 표시되고 있었음
      // (2026-07-24 실제 시트 스크린샷 대조로 확인됨).
      entry.category             = (row[1]  || '').toString().trim();
      entry.type                 = (row[2]  || '').toString().trim();
      entry.duration_min         = parseFloat(row[3])  || null;
      entry.sets                 = parseInt(row[4])    || null;
      entry.reps                 = parseInt(row[5])    || null;
      entry.weight_per_set_kg    = parseFloat(row[6])  || null;
      entry.distance_km          = parseFloat(row[7])  || null;
      entry.steps                = parseInt(row[8])    || null;
      entry.calories_burned_kcal = parseFloat(row[9])  || null;
      entry.met_value            = parseFloat(row[10]) || null;
      entry.add_to_calendar      = (row[11] || '').toString().trim();
      entry.unit_pref            = (row[12] || 'metric').toString().trim();
      entry.notes                = (row[13] || '').toString().trim();

    } else if (tabName === 'health') {
      // [v4.0] Body 탭 — 27컬럼 (col 0=date … col 26=unit_pref)
      // custom_item_name(24), custom_item_value(25), custom_item_unit(26) 추가
      entry.weight_kg             = parseFloat(row[1])  || null; entry.weight_lb          = parseFloat(row[2])  || null;
      entry.bmi                   = parseFloat(row[3])  || null;
      entry.lean_mass_kg_boer     = parseFloat(row[4])  || null; entry.lean_mass_lb       = parseFloat(row[5])  || null;
      entry.body_fat_kg           = parseFloat(row[6])  || null; entry.body_fat_pct       = parseFloat(row[7])  || null;
      entry.muscle_mass_kg        = parseFloat(row[8])  || null; entry.muscle_mass_lb     = parseFloat(row[9])  || null;
      entry.manual_body_fat_pct   = (row[10] || '').toString().trim();
      entry.manual_muscle_mass_kg = (row[11] || '').toString().trim();
      entry.blood_pressure_sys    = parseFloat(row[12]) || null; entry.blood_pressure_dia = parseFloat(row[13]) || null;
      entry.heart_rate_bpm        = parseFloat(row[14]) || null; entry.spo2_pct           = parseFloat(row[15]) || null;
      entry.glucose_mgdl          = parseFloat(row[16]) || null; entry.glucose_mmol       = parseFloat(row[17]) || null;
      entry.temperature_c         = parseFloat(row[18]) || null; entry.temperature_f      = parseFloat(row[19]) || null;
      entry.cholesterol_mgdl      = parseFloat(row[20]) || null; entry.cholesterol_mmol   = parseFloat(row[21]) || null;
      entry.notes                 = (row[22] || '').toString().trim();
      entry.unit_pref             = (row[23] || 'metric').toString().trim();
      entry.custom_item_name      = (row[24] || '').toString().trim(); // [v4.0]
      entry.custom_item_value     = (row[25] || '').toString().trim(); // [v4.0]
      entry.custom_item_unit      = (row[26] || '').toString().trim(); // [v4.0]

    } else if (tabName === 'sleep') {
      entry.bedtime         = (row[1] || '').toString().trim(); entry.wake_time  = (row[2] || '').toString().trim();
      entry.duration_min    = parseFloat(row[3]) || null;       entry.duration_hr = parseFloat(row[4]) || null;
      entry.quality_1to5    = parseInt(row[5])   || null;
      entry.notes           = (row[6] || '').toString().trim();
      entry.unit_pref       = (row[7] || 'metric').toString().trim();
      entry.add_to_calendar = (row[8] || '').toString().trim(); // [v4.0]

    } else if (tabName === 'mood') {
      entry.mood              = (row[1] || '').toString().trim();
      entry.energy_level_1to5 = parseInt(row[2]) || null;       // [v4.0] energy_level → energy_level_1to5
      entry.notes             = (row[3] || '').toString().trim();
      entry.unit_pref         = (row[4] || 'metric').toString().trim();
      entry.add_to_calendar   = (row[5] || '').toString().trim(); // [v4.0]

    } else if (tabName === 'custom') {
      entry.item_name = (row[1] || '').toString().trim();
      entry.value     = (row[2] || '').toString().trim();
      entry.unit      = (row[3] || '').toString().trim();
      entry.notes     = (row[4] || '').toString().trim();

    } else if (tabName === 'water') {
      // [v4.0] T-Water: 8컬럼
      entry.amount_ml   = parseFloat(row[1]) || null;
      entry.amount_floz = parseFloat(row[2]) || null;
      entry.drink_type  = (row[3] || '').toString().trim();
      entry.time_of_day = (row[4] || '').toString().trim();
      entry.goal_ml     = parseFloat(row[5]) || null;
      entry.cumulative_ml = parseFloat(row[6]) || null;
      entry.notes       = (row[7] || '').toString().trim();

    } else if (tabName === 'medication') {
      // [v4.0] T-Medication: 케이스B(복약체크) — 기존 행 update
      entry.med_name      = (row[1] || '').toString().trim();
      entry.dose          = (row[2] || '').toString().trim();
      entry.unit          = (row[3] || '').toString().trim();
      entry.frequency     = (row[4] || '').toString().trim();
      entry.time_of_day   = (row[5] || '').toString().trim();
      entry.taken         = (row[6] || '').toString().trim();   // Y/N
      entry.taken_at      = (row[7] || '').toString().trim();
      entry.notes         = (row[8] || '').toString().trim();

    } else if (tabName === 'womens') {
      // [v4.1] Women 탭 — 실제 시트 헤더(A~AG, 33컬럼) 순서에 맞춰 재작성.
      // buildHealthRow_의 [v4.1] 수정과 동일한 컬럼 순서를 사용함(쓰기/읽기 일치).
      entry.mode                        = (row[1]  || '').toString().trim();
      entry.period_start                = (row[2]  || '').toString().trim();
      entry.period_end                  = (row[3]  || '').toString().trim();
      entry.ovulation                   = (row[4]  || '').toString().trim();
      entry.ov_test_result              = (row[5]  || '').toString().trim();
      entry.ov_test_time                = (row[6]  || '').toString().trim();
      entry.preg_test_result            = (row[7]  || '').toString().trim();
      entry.preg_test_time              = (row[8]  || '').toString().trim();
      entry.cervical_mucus_feeling      = (row[9]  || '').toString().trim();
      entry.cervical_mucus_color        = (row[10] || '').toString().trim();
      entry.cervical_mucus_type         = (row[11] || '').toString().trim();
      entry.symptoms                    = (row[12] || '').toString().trim();
      entry.symptom_severity            = (row[13] || '').toString().trim();
      entry.medications                 = (row[14] || '').toString().trim();
      entry.sex_count                   = (row[15] || '').toString().trim();
      entry.condom                      = (row[16] || '').toString().trim();
      entry.orgasm_count                = (row[17] || '').toString().trim();
      entry.masturbation_count          = (row[18] || '').toString().trim();
      entry.sex_time                    = (row[19] || '').toString().trim();
      entry.morning_sickness_count      = (row[20] || '').toString().trim();
      entry.morning_sickness_severity   = (row[21] || '').toString().trim();
      entry.morning_sickness_note       = (row[22] || '').toString().trim();
      entry.clinic_visit_type           = (row[23] || '').toString().trim();
      entry.clinic_visit_note           = (row[24] || '').toString().trim();
      entry.clinic_next_appointment     = (row[25] || '').toString().trim();
      entry.bp_sys                      = (row[26] || '').toString().trim();
      entry.bp_dia                      = (row[27] || '').toString().trim();
      entry.mood                        = (row[28] || '').toString().trim();
      entry.energy_level                = (row[29] || '').toString().trim();
      entry.add_to_calendar             = (row[30] || '').toString().trim();
      entry.note                        = (row[31] || '').toString().trim();
      entry.unit_pref                   = (row[32] || 'metric').toString().trim();
      entry.calendar_event_id           = (row[33] || '').toString().trim(); // [v4.6] AH

    } else if (tabName === 'womens_bp') {
      // [v4.2] Women_BP 탭 — 실제 시트 헤더(stamp_date, bp_sys, bp_dia, notes, source) 5컬럼
      entry.bp_sys  = parseFloat(row[1]) || null;
      entry.bp_dia  = parseFloat(row[2]) || null;
      entry.notes   = (row[3] || '').toString().trim();
      entry.source  = (row[4] || '').toString().trim();

    } else if (tabName === 'womens_mood') {
      // [v4.2] Women_Mood 탭 — 실제 시트 헤더(stamp_date, mood, energy_level_1to5, notes, source) 5컬럼
      entry.mood         = (row[1] || '').toString().trim();
      entry.energy_level = parseInt(row[2]) || null;
      entry.notes         = (row[3] || '').toString().trim();
      entry.source        = (row[4] || '').toString().trim();

    } else if (tabName === 'fetal_movement' || tabName === 'baby_kick') {
      // [v4.0] Pregnancy 탭 — entry_type으로 구분
      entry.entry_type      = (row[1] || '').toString().trim();  // fetal_movement | baby_kick
      entry.kick_count      = parseInt(row[2])  || null;
      entry.session_min     = parseFloat(row[3]) || null;
      entry.time_of_day     = (row[4] || '').toString().trim();
      entry.intensity       = (row[5] || '').toString().trim();
      entry.pregnancy_week  = parseInt(row[6])  || null;
      entry.notes           = (row[7] || '').toString().trim();
    }

    result.push(entry);
  }
  return result;
}

function buildHealthSummary_(food, activity, health, sleep, mood) {
  return {
    total_calories_kcal:        food.reduce((s, r) => s + (r.calories_kcal || 0), 0),
    total_protein_g:            +food.reduce((s, r) => s + (r.protein_g || 0), 0).toFixed(1),
    total_carbs_g:              +food.reduce((s, r) => s + (r.carbs_g   || 0), 0).toFixed(1),
    total_fat_g:                +food.reduce((s, r) => s + (r.fat_g     || 0), 0).toFixed(1),
    total_fiber_g:              +food.reduce((s, r) => s + (r.fiber_g   || 0), 0).toFixed(1),
    total_calories_burned_kcal: activity.reduce((s, r) => s + (r.calories_burned_kcal || 0), 0),
    total_steps:                activity.reduce((s, r) => s + (r.steps || 0), 0),
    total_distance_km:          +activity.reduce((s, r) => s + (r.distance_km || 0), 0).toFixed(2),
    latest_weight_kg:    health.length ? health[health.length - 1].weight_kg    : null,
    latest_bmi:          health.length ? health[health.length - 1].bmi          : null,
    latest_body_fat_pct: health.length ? health[health.length - 1].body_fat_pct : null,
    sleep_duration_min:  sleep.length  ? sleep[sleep.length - 1].duration_min   : null,
    sleep_quality:       sleep.length  ? sleep[sleep.length - 1].quality_1to5   : null,
    mood:                mood.length   ? mood[mood.length - 1].mood             : null,
    energy_level:        mood.length   ? mood[mood.length - 1].energy_level_1to5 : null,
  };
}

// [신규] weekly/monthly 조회용 평균 분석. buildHealthSummary_는 (지난 수정으로)
// 항상 targetDate 하루치만 반영하도록 고정했으니, 기간 전체를 분석하고 싶을 때
// 쓸 곳이 없어졌다 — 그 자리를 메우는 함수. "합계"가 아니라 "평균"을 낸다는 게
// 핵심이다: 예전 buildHealthSummary_(period=monthly)는 그 달 30일치를 그냥 다
// 더한 값을 "요약"이라고 반환해서, 예를 들어 total_steps가 30만보처럼 나와도
// 하루 평균인지 한 달 합계인지 필드명만 봐선 알 수 없었다. 이 함수는 그 문제를
// "평균"이라는 이름표를 붙여 명확히 분리해서 다시 제공한다.
//
// 평균의 분모(일수)는 "그 항목이 실제로 기록된 날짜 수"로 잡는다(기간 전체 일수가
// 아니라) — 기록 안 한 날을 0으로 계산에 섞으면 평균이 실제보다 낮게 나오는
// 문제가 생기기 때문. 체중/BMI/체지방률/수면은 "그 항목의 마지막 값"이 아니라
// 기간 내 모든 개별 기록값의 평균을 낸다(latest_* 대신 avg_*). mood는 숫자가
// 아니라 범주형이라 평균이 성립하지 않으므로, 기간 내 가장 많이 기록된
// mood(최빈값)를 대신 반환한다.
function countDistinctDates_(arr) {
  const seen = {};
  arr.forEach(r => { const d = (r.stamp_date || '').toString().slice(0, 10); if (d) seen[d] = true; });
  return Object.keys(seen).length;
}
function avgPerDay_(sum, days) { return days ? +(sum / days).toFixed(1) : null; }
function avgOfField_(arr, field) {
  const vals = arr.map(r => r[field]).filter(v => v !== null && v !== undefined && !isNaN(v));
  if (!vals.length) return null;
  return +(vals.reduce((a, b) => a + b, 0) / vals.length).toFixed(1);
}
function buildHealthPeriodAverage_(food, activity, health, sleep, mood) {
  const foodDays     = countDistinctDates_(food);
  const activityDays = countDistinctDates_(activity);

  const totalCal     = food.reduce((s, r) => s + (r.calories_kcal || 0), 0);
  const totalProtein = food.reduce((s, r) => s + (r.protein_g   || 0), 0);
  const totalCarbs   = food.reduce((s, r) => s + (r.carbs_g     || 0), 0);
  const totalFat     = food.reduce((s, r) => s + (r.fat_g       || 0), 0);
  const totalFiber   = food.reduce((s, r) => s + (r.fiber_g     || 0), 0);
  const totalBurned  = activity.reduce((s, r) => s + (r.calories_burned_kcal || 0), 0);
  const totalSteps   = activity.reduce((s, r) => s + (r.steps          || 0), 0);
  const totalDist    = activity.reduce((s, r) => s + (r.distance_km    || 0), 0);

  const moodCounts = {};
  mood.forEach(r => { if (r.mood) moodCounts[r.mood] = (moodCounts[r.mood] || 0) + 1; });
  let mostFrequentMood = null, topCount = 0;
  Object.keys(moodCounts).forEach(k => { if (moodCounts[k] > topCount) { topCount = moodCounts[k]; mostFrequentMood = k; } });

  return {
    days_with_food_log:               foodDays,
    avg_calories_kcal_per_day:        avgPerDay_(totalCal,    foodDays),
    avg_protein_g_per_day:            avgPerDay_(totalProtein, foodDays),
    avg_carbs_g_per_day:              avgPerDay_(totalCarbs,   foodDays),
    avg_fat_g_per_day:                avgPerDay_(totalFat,     foodDays),
    avg_fiber_g_per_day:              avgPerDay_(totalFiber,   foodDays),
    days_with_activity_log:           activityDays,
    avg_calories_burned_kcal_per_day: avgPerDay_(totalBurned, activityDays),
    avg_steps_per_day:                avgPerDay_(totalSteps,  activityDays),
    avg_distance_km_per_day:          avgPerDay_(totalDist,   activityDays),
    avg_weight_kg:                    avgOfField_(health, 'weight_kg'),
    avg_bmi:                          avgOfField_(health, 'bmi'),
    avg_body_fat_pct:                 avgOfField_(health, 'body_fat_pct'),
    avg_sleep_duration_min:           avgOfField_(sleep, 'duration_min'),
    avg_sleep_quality:                avgOfField_(sleep, 'quality_1to5'),
    most_frequent_mood:               mostFrequentMood,
  };
}

// ============================================================================
// parseHealthBaseline_ — Baseline 시트 파싱
// [v4.0] dob 컬럼 추가 (col 16) → 총 17컬럼 (0-16)
// ============================================================================
function parseHealthBaseline_(rows) {
  let latest = null;
  for (let r = 3; r < rows.length; r++) {
    const row = rows[r]; if (!row || !row[0]) continue;
    const dateRaw = (row[0] || '').toString().trim(); if (!dateRaw) continue;
    // [v4.1] 컬럼 순서 수정 — 실제 시트 헤더(A:recorded_date B:dob C:sex D:age E:height_cm
    // F:height_ft G:height_in H:weight_kg I:weight_lb ...)를 기준으로 재정렬함.
    // 기존 코드는 dob이 Q열(마지막)에 있다고 가정했으나 실제로는 B열(2번째)에 있어
    // sex 이후 전 필드가 한 칸씩 밀려 잘못 읽히고 있었음(2026-07-24 CSV 대조로 확인).
    latest = {
      recorded_date:  dateRaw,
      dob:            (row[1]  || '').toString().trim(),
      sex:            (row[2]  || '').toString().trim(),
      age:            parseInt(row[3])   || null,
      height_cm:      parseFloat(row[4]) || null,
      height_ft:      parseFloat(row[5]) || null,
      height_in:      parseFloat(row[6]) || null,
      weight_kg:      parseFloat(row[7]) || null,
      weight_lb:      parseFloat(row[8]) || null,
      blood_type:     (row[9]  || '').toString().trim(),
      allergies:      (row[10] || '').toString().trim(),
      emergency_contact: (row[11] || '').toString().trim(),
      activity_level: parseFloat(row[12]) || 1.55,
      activity_label: (row[13] || '').toString().trim(),
      bmr_kcal:       parseFloat(row[14]) || null,
      tdee_kcal:      parseFloat(row[15]) || null,
      unit_pref:      (row[16] || 'metric').toString().trim(),
    };
  }
  return latest;
}

function parseHealthGoal_(rows) {
  let latest = null;
  for (let r = 3; r < rows.length; r++) {
    const row = rows[r]; if (!row || !row[0]) continue;
    const dateRaw = (row[0] || '').toString().trim(); if (!dateRaw) continue;
    latest = {
      recorded_date: dateRaw, goal_type: (row[1] || 'maintain').toString().trim(),
      target_weight_kg: parseFloat(row[2]) || null, target_weight_lb: parseFloat(row[3]) || null,
      duration_months: parseFloat(row[4]) || null,
      daily_calorie_intake_kcal: parseFloat(row[5]) || null, daily_exercise_cal_kcal: parseFloat(row[6]) || null,
      weekly_pace_kg: parseFloat(row[7]) || null, weekly_pace_lb: parseFloat(row[8]) || null,
      water_goal_ml: parseFloat(row[9]) || null, water_goal_oz: parseFloat(row[10]) || null,
      sleep_goal_min: parseFloat(row[11]) || null, sleep_goal_hr: parseFloat(row[12]) || null,
      notes: (row[13] || '').toString().trim(),
    };
  }
  return latest;
}

