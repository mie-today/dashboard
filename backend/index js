app.get('/api/me/events', async (req, res) => {
  try {
    if (!req.session || !req.session.tokens) return res.status(401).json({ error: 'NOT_CONNECTED' });
    res.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
    res.set('Pragma', 'no-cache'); res.set('Expires', '0'); res.set('Surrogate-Control', 'no-store');
    const client   = createOAuth2Client(req);
    const calendar = google.calendar({ version: 'v3', auth: client });
    const now = new Date();
    let timeMin, timeMax;
    const qMin = req.query.timeMin, qMax = req.query.timeMax;
    if (qMin && qMax) {
      const parsedMin = new Date(qMin), parsedMax = new Date(qMax);
      if (!isNaN(parsedMin.getTime()) && !isNaN(parsedMax.getTime())) {
        timeMin = parsedMin; timeMax = parsedMax;
        console.log(`📅 Events requested for range: ${qMin} → ${qMax}`);
      } else {
        timeMin = new Date(now); timeMin.setFullYear(now.getFullYear() - 1);
        timeMax = new Date(now); timeMax.setFullYear(now.getFullYear() + 1);
      }
    } else {
      timeMin = new Date(now); timeMin.setFullYear(now.getFullYear() - 1);
      timeMax = new Date(now); timeMax.setFullYear(now.getFullYear() + 1);
    }
    const baseOptions = {
      timeMin: timeMin.toISOString(), timeMax: timeMax.toISOString(),
      singleEvents: true, showDeleted: false, orderBy: 'startTime', maxResults: 2500
    };
    const calListRes = await calendar.calendarList.list();
    const allEvents  = [];
    for (const cal of (calListRes.data.items || [])) {
      try {
        const items = await listAllEventsForCalendar(calendar, cal.id, baseOptions);
        for (const ev of items) {
          if (!ev.start || (!ev.start.date && !ev.start.dateTime)) continue;
          const calColor    = cal.backgroundColor || cal.foregroundColor || null;
          const eventColor  = ev.colorId ? await getEventColorById(calendar, ev.colorId) : null;
          const chosenColor = eventColor || calColor;
          allEvents.push({
            ...ev, calendarId: cal.id, mieCalendarId: cal.id,
            mieCalendarSummary: cal.summaryOverride || cal.summary || '',
            mieCalendarColor: chosenColor, _mieCalendarColor: chosenColor
          });
        }
      } catch (err) { console.error(`Error listing events for calendar ${cal.id}:`, err); }
    }
    allEvents.sort((a, b) => {
      const aStart = (a.start && (a.start.dateTime || a.start.date)) || '';
      const bStart = (b.start && (b.start.dateTime || b.start.date)) || '';
      return aStart.localeCompare(bStart);
    });
    console.log(`✅ Returning ${allEvents.length} events`);
    res.status(200).json({ events: allEvents });
  } catch (err) {
    console.error('Error in /api/me/events:', err);
    if (isReauthRequiredError_(err)) {
      return res.status(401).json({ error: 'REAUTH_REQUIRED', message: err.message || String(err) });
    }
    res.status(err.code === 403 ? 403 : err.code === 404 ? 404 : 500)
       .json({ error: 'EVENT_FETCH_FAILED', message: err.message || String(err) });
  }
});

