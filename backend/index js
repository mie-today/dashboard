// ============================================================================
app.post('/api/me/health/log', async (req, res) => {
  try {
    if (!req.session || !req.session.tokens) return res.status(401).json({ error: 'NOT_CONNECTED' });
    const { tab, data, unit_pref } = req.body || {};
    if (!tab)  return res.status(400).json({ error: 'MISSING_TAB' });
    if (!data) return res.status(400).json({ error: 'MISSING_DATA' });
    if (!HEALTH_TAB_MAP[tab]) return res.status(400).json({ error: 'INVALID_TAB' });
    const userInfo  = req.session.user || {};
    const userEmail = (userInfo.email || userInfo.primaryEmail || '').toLowerCase();
    const healthSheetId = await getHealthSheetId_(userEmail);
    const adminToken    = await getRefreshTokenForEmail(HEALTH_ADMIN);
    if (!adminToken) return res.status(500).json({ error: 'NO_ADMIN_TOKEN' });
    const adminClient = createOAuth2Client(null);
    adminClient.setCredentials({ refresh_token: adminToken });
    const sheets = google.sheets({ version: 'v4', auth: adminClient });
    const stamp = data.stamp_date || new Date().toISOString().slice(0, 19).replace('T', ' ');
    let converted = convertUnits_({ ...data, stamp_date: stamp, unit_pref: unit_pref || 'metric' }, tab);
    if (tab === 'activity' && converted.met_value && converted.duration_min && converted.weight_kg) {
      converted.calories_burned_kcal = calcActivityCalories_(converted.met_value, converted.weight_kg, converted.duration_min);
    }
    if (tab === 'sleep' && converted.bedtime && converted.wake_time && !converted.duration_min) {
      try {
        const [bH, bM] = converted.bedtime.split(':').map(Number);
        const [wH, wM] = converted.wake_time.split(':').map(Number);
        let mins = (wH * 60 + wM) - (bH * 60 + bM);
        if (mins < 0) mins += 1440;
        converted.duration_min = mins; converted.duration_hr = +(mins / 60).toFixed(1);
      } catch (e) {}
    }

    // [v4.0] medication 케이스B: 복약체크 — taken/taken_at update (기존 행 찾아 update)
    if (tab === 'medication' && data.med_id) {
      // med_id로 기존 행 찾아 update (taken='Y', taken_at=stamp)
      const tabRes = await sheets.spreadsheets.values.get({ spreadsheetId: healthSheetId, range: `${HEALTH_TAB_MAP[tab]}!A:I` });
      const rows   = tabRes.data.values || [];
      let targetRow = null;
      for (let r = 3; r < rows.length; r++) {
        if (!rows[r] || !rows[r][0]) continue;
        if ((rows[r][1] || '').toString().trim() === data.med_name) { targetRow = r + 1; break; }
      }
      if (targetRow) {
        await sheets.spreadsheets.values.batchUpdate({
          spreadsheetId: healthSheetId,
          requestBody: {
            valueInputOption: 'USER_ENTERED',
            data: [
              { range: `${HEALTH_TAB_MAP[tab]}!G${targetRow}`, values: [[data.taken || 'Y']] },
              { range: `${HEALTH_TAB_MAP[tab]}!H${targetRow}`, values: [[stamp]] },
            ],
          },
        });
        console.log(`✅ Medication check updated for ${data.med_name} (row ${targetRow})`);
        return res.status(200).json({ ok: true, tab, updated_row: targetRow, data: converted });
      }
      // 행을 못 찾으면 새로 추가
    }

    const appendRes = await sheets.spreadsheets.values.append({
      spreadsheetId: healthSheetId, range: `${HEALTH_TAB_MAP[tab]}!A:A`,
      valueInputOption: 'USER_ENTERED', insertDataOption: 'INSERT_ROWS',
      requestBody: { values: [buildHealthRow_(tab, converted)] },
    });
    const rowNum = ((appendRes.data.updates || {}).updatedRange || '').match(/(\d+)$/);
    console.log(`✅ Health log (${tab}) saved for ${userEmail}`);

    // [되살림] Finance의 createCalendarEvent와 동일한 패턴 — add_to_calendar='Y'/true면
    // 실제 Google Calendar 이벤트 생성. 이벤트 ID는 시트에 저장하지 않음(일회성, 수정/삭제 추적 불필요 — 확인됨).
    let calendarEvent = null;
    let calendarReauthRequired = false;
    const wantsCalendar = converted.add_to_calendar === true ||
      ['y', 'yes', 'true', '1'].includes(String(converted.add_to_calendar || '').trim().toLowerCase());
    if (wantsCalendar) {
      try {
        const userClient = createOAuth2Client(req);
        const calendar   = google.calendar({ version: 'v3', auth: userClient });
        const eventDate  = (converted.stamp_date || stamp || '').toString().slice(0, 10) || new Date().toISOString().slice(0, 10);
        const eventTitle = buildHealthEventTitle_(tab, converted);
        const eventBody  = {
          summary: eventTitle, description: converted.notes || '',
          start: { date: eventDate }, end: { date: eventDate }, visibility: 'private',
        };
        const calRes = await calendar.events.insert({ calendarId: 'primary', requestBody: eventBody });
        calendarEvent = { id: calRes.data.id, htmlLink: calRes.data.htmlLink };
      } catch (calErr) {
        console.error('Health calendar event creation failed:', calErr.message);
        // [REAUTH_REQUIRED 신호] health 로그 자체(위 appendRes)는 이미 저장 성공했으므로
        // 전체 요청을 실패 처리하지 않고, 캘린더 파트만 실패했다는 신호를 응답에 실어 보낸다.
        // 프론트는 이 플래그를 보고 재연결 배너를 띄우면 된다 (health 데이터는 이미 저장됐음을 알림).
        if (isReauthRequiredError_(calErr)) calendarReauthRequired = true;
      }
    }

    res.status(200).json({
      ok: true, tab, row: rowNum ? parseInt(rowNum[1]) : null, data: converted,
      calendar_event: calendarEvent, calendar_reauth_required: calendarReauthRequired,
    });
  } catch (err) {
    console.error('Error in /api/me/health/log:', err);
    res.status(500).json({ error: 'HEALTH_LOG_FAILED', message: err.message });
  }
});

