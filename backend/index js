      range: `${HEALTH_TAB_MAP[t]}!A:${TAB_RANGE[t] || 'Z'}`,
    }));
    const results = await Promise.all(
      ranges.map(({ range }) => sheets.spreadsheets.values.get({ spreadsheetId: healthSheetId, range }))
    );
    const parsed = {};
    ranges.forEach(({ tab }, i) => { parsed[tab] = parseHealthRows_(results[i].data.values || [], tab, targetDate, period); });

    const food     = parsed['food']     || [];
    const activity = parsed['activity'] || [];
    const health   = parsed['health']   || [];
    const sleep    = parsed['sleep']    || [];
    const mood     = parsed['mood']     || [];
    const custom   = parsed['custom']   || [];

    // [부수 발견 수정] buildHealthSummary_는 필드명(total_steps, total_calories_burned_kcal 등)이
    // 마치 "하루치" 값을 뜻하는 것처럼 보이지만, 실제로는 period로 필터링된 배열(food/activity/...)을
    // 그대로 합산한다. period=monthly로 조회하면 summary가 "그 달 전체 합계"를 반환하면서
    // 필드 이름은 하루 단위처럼 보이는 오해의 소지가 있었다.
    // → summary는 항상 targetDate 하루 기준으로 고정해서 계산하고(요청한 period와 무관하게),
    //   food/activity/health/sleep/mood/custom 등 원본 배열 응답은 기존처럼 요청한 period
    //   전체를 그대로 반환한다(weekly/monthly 조회 기능 자체는 그대로 유지).
    const dailyOnly_ = (arr) => arr.filter(r => (r.stamp_date || '').toString().slice(0, 10) === targetDate);
    const summaryFood     = period === 'daily' ? food     : dailyOnly_(food);
    const summaryActivity = period === 'daily' ? activity : dailyOnly_(activity);
    const summaryHealth   = period === 'daily' ? health   : dailyOnly_(health);
    const summarySleep    = period === 'daily' ? sleep    : dailyOnly_(sleep);
    const summaryMood     = period === 'daily' ? mood     : dailyOnly_(mood);

    const responseObj = {
      date: targetDate, period,
      summary: buildHealthSummary_(summaryFood, summaryActivity, summaryHealth, summarySleep, summaryMood),
      food, activity, health, sleep, mood, custom,
    };
    // [신규] weekly/monthly 조회는 원본 배열(food/activity/...)이 그 기간 전체이므로,
    // 그걸 그대로 평균 분석해서 별도 필드로 얹어준다 — summary(위)는 항상 하루치라
    // 기간 분석이 필요한 화면(예: 대시보드 Weekly/Monthly 드롭다운)은 이 필드를 써야 한다.
    // daily 조회는 하루=기간이라 summary와 중복이라 안 붙임.
    if (period !== 'daily') {
      responseObj.period_average = buildHealthPeriodAverage_(food, activity, health, sleep, mood);
    }
    // 신규 탭 결과도 포함
    ['water','medication','womens','womens_bp','womens_mood','fetal_movement','baby_kick'].forEach(t => {
      if (parsed[t]) responseObj[t] = parsed[t];
    });

    res.set('Cache-Control', 'no-store');
    res.status(200).json(responseObj);
  } catch (err) {
    console.error('Error in /api/me/health:', err);
    res.status(500).json({ error: 'HEALTH_FETCH_FAILED', message: err.message });
  }
});

