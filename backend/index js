    const sheets = google.sheets({ version: 'v4', auth: adminClient });
    const result = await sheets.spreadsheets.values.get({ spreadsheetId: MASTER_SHEET_ID, range: 'UserInfo!A:AC' });
    const rows = result.data.values || [];
    let sheetRow = null;
    for (let r = 1; r < rows.length; r++) {
      const rowEmail = (rows[r][2] || '').toString().trim().toLowerCase();
